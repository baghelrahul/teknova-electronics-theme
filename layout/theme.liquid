<!doctype html>
<html class="no-js scroll-smooth" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <!-- Google Fonts: Manrope & Hanken Grotesk -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Google Material Symbols Outlined -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "on-secondary-container": "#fefcff",
              "primary": "#630ed4",
              "tertiary-fixed": "#dfe2f1",
              "secondary-fixed-dim": "#b4c5ff",
              "tertiary-container": "#636673",
              "inverse-primary": "#d2bbff",
              "on-background": "#111c2d",
              "surface-container-highest": "#d8e3fb",
              "on-tertiary-fixed": "#171b26",
              "on-primary": "#ffffff",
              "on-error": "#ffffff",
              "primary-container": "#7c3aed",
              "on-primary-container": "#ede0ff",
              "primary-fixed-dim": "#d2bbff",
              "outline-variant": "#ccc3d8",
              "error-container": "#ffdad6",
              "inverse-on-surface": "#ecf1ff",
              "surface-variant": "#d8e3fb",
              "on-secondary": "#ffffff",
              "secondary-fixed": "#dbe1ff",
              "tertiary-fixed-dim": "#c3c6d4",
              "on-secondary-fixed": "#00174b",
              "surface-bright": "#f9f9ff",
              "surface-container-low": "#f0f3ff",
              "on-error-container": "#93000a",
              "surface-tint": "#732ee4",
              "tertiary": "#4b4e5a",
              "surface-container": "#e7eeff",
              "on-tertiary-fixed-variant": "#434652",
              "error": "#ba1a1a",
              "outline": "#7b7487",
              "surface": "#f9f9ff",
              "secondary-container": "#316bf3",
              "background": "#f9f9ff",
              "on-tertiary": "#ffffff",
              "on-primary-fixed": "#25005a",
              "surface-container-high": "#dee8ff",
              "on-surface": "#111c2d",
              "on-secondary-fixed-variant": "#003ea8",
              "inverse-surface": "#263143",
              "on-tertiary-container": "#e2e5f4",
              "secondary": "#0051d5",
              "on-surface-variant": "#4a4455",
              "surface-dim": "#cfdaf2",
              "surface-container-lowest": "#ffffff",
              "on-primary-fixed-variant": "#5a00c6",
              "primary-fixed": "#eaddff"
            },
            fontFamily: {
              "headline": ["Manrope", "sans-serif"],
              "body": ["Hanken Grotesk", "sans-serif"],
              "display": ["Manrope", "sans-serif"],
              "headline-lg": ["Manrope", "sans-serif"],
              "headline-md": ["Manrope", "sans-serif"],
              "headline-sm": ["Manrope", "sans-serif"],
              "body-lg": ["Hanken Grotesk", "sans-serif"],
              "body-md": ["Hanken Grotesk", "sans-serif"],
              "body-sm": ["Hanken Grotesk", "sans-serif"],
              "label-md": ["Hanken Grotesk", "sans-serif"],
              "label-sm": ["Hanken Grotesk", "sans-serif"]
            },
            fontSize: {
              "display": ["4.5rem", { lineHeight: "1.05", letterSpacing: "-0.035em", fontWeight: "700" }],
              "headline-lg": ["3rem", { lineHeight: "1.1", letterSpacing: "-0.025em", fontWeight: "700" }],
              "headline-md": ["2rem", { lineHeight: "1.2", letterSpacing: "-0.02em", fontWeight: "600" }],
              "headline-sm": ["1.375rem", { lineHeight: "1.3", letterSpacing: "-0.015em", fontWeight: "600" }],
              "body-lg": ["1.125rem", { lineHeight: "1.6", letterSpacing: "-0.01em", fontWeight: "400" }],
              "body-md": ["0.9375rem", { lineHeight: "1.5", letterSpacing: "-0.005em", fontWeight: "400" }],
              "body-sm": ["0.8125rem", { lineHeight: "1.45", letterSpacing: "0em", fontWeight: "400" }],
              "label-md": ["0.75rem", { lineHeight: "1", letterSpacing: "0.06em", fontWeight: "600" }],
              "label-sm": ["0.6875rem", { lineHeight: "1", letterSpacing: "0.08em", fontWeight: "500" }]
            }
          }
        }
      }
    </script>

    {{ 'nexora-theme.css' | asset_url | stylesheet_tag }}
    <style>
      [data-wishlist-count]:empty { display: none !important; }
    </style>
    {{ content_for_header }}
  </head>

  <body class="bg-background text-on-surface font-body-md text-body-md antialiased selection:bg-primary selection:text-on-primary">
    <!-- Announcement Bar Section Area -->
    {% section 'announcement-bar' %}

    <!-- Sticky Header & Navigation -->
    {% section 'header' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Mega Footer -->
    {% section 'footer' %}

    <script src="{{ 'nexora-theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
