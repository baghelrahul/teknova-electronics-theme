{%- comment -%}
  NEXORA / TEKNOVA - Section 10: Why Shop With Us
  4 brand trust guarantee cards with icons and descriptions
{%- endcomment -%}

<section class="py-16 bg-surface-container-lowest border-t border-outline-variant/30">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-label-md font-label-md uppercase tracking-wider text-primary font-semibold">
        {{ section.settings.eyebrow | default: 'The NEXORA Guarantee' }}
      </span>
      <h2 class="text-headline-md font-headline-md text-on-surface mt-1">
        {{ section.settings.heading | default: 'Engineered for Complete Confidence' }}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/40 hover:border-primary/40 transition-colors" {{ block.shopify_attributes }}>
            <div class="w-12 h-12 rounded-xl bg-surface-container-lowest flex items-center justify-center {{ block.settings.icon_color | default: 'text-primary' }} shadow-sm mb-4">
              <span class="material-symbols-outlined text-[26px]">{{ block.settings.icon }}</span>
            </div>
            <h3 class="text-headline-sm font-headline-sm text-[18px] text-on-surface mb-2 font-bold">
              {{ block.settings.title }}
            </h3>
            <p class="text-body-sm font-body-sm text-on-surface-variant leading-relaxed">
              {{ block.settings.description }}
            </p>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback Default Guarantee Cards -->
        <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/40 hover:border-primary/40 transition-colors shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-surface-container-lowest flex items-center justify-center text-primary shadow-sm mb-4">
            <span class="material-symbols-outlined text-[26px]">verified</span>
          </div>
          <h3 class="text-headline-sm font-headline-sm text-[18px] text-on-surface mb-2 font-bold">
            100% Genuine Products
          </h3>
          <p class="text-body-sm font-body-sm text-on-surface-variant leading-relaxed">
            Directly sourced from authorized global brands with verified digital serial authentication on delivery.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/40 hover:border-primary/40 transition-colors shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-surface-container-lowest flex items-center justify-center text-secondary shadow-sm mb-4">
            <span class="material-symbols-outlined text-[26px]">lock</span>
          </div>
          <h3 class="text-headline-sm font-headline-sm text-[18px] text-on-surface mb-2 font-bold">
            Bank-Grade Secure Checkout
          </h3>
          <p class="text-body-sm font-body-sm text-on-surface-variant leading-relaxed">
            256-bit encrypted transactions supporting No-Cost EMI, UPI Instant, Major Cards, and Net Banking.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/40 hover:border-primary/40 transition-colors shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-surface-container-lowest flex items-center justify-center text-primary shadow-sm mb-4">
            <span class="material-symbols-outlined text-[26px]">electric_bolt</span>
          </div>
          <h3 class="text-headline-sm font-headline-sm text-[18px] text-on-surface mb-2 font-bold">
            Fast &amp; Insured Delivery
          </h3>
          <p class="text-body-sm font-body-sm text-on-surface-variant leading-relaxed">
            Priority dispatch within 6 hours with tamper-proof security seals and comprehensive in-transit insurance.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/40 hover:border-primary/40 transition-colors shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-surface-container-lowest flex items-center justify-center text-secondary shadow-sm mb-4">
            <span class="material-symbols-outlined text-[26px]">sync</span>
          </div>
          <h3 class="text-headline-sm font-headline-sm text-[18px] text-on-surface mb-2 font-bold">
            7-Day Easy Replacement
          </h3>
          <p class="text-body-sm font-body-sm text-on-surface-variant leading-relaxed">
            Zero-friction doorstep inspection and 1-Year official brand manufacturer replacement warranty assistance.
          </p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Shop With Us",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "The NEXORA Guarantee"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered for Complete Confidence"
    }
  ],
  "blocks": [
    {
      "type": "benefit_card",
      "name": "Trust Benefit Card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Material Symbol Icon",
          "default": "verified"
        },
        {
          "type": "text",
          "id": "icon_color",
          "label": "Icon Color Class",
          "default": "text-primary"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "100% Genuine Products"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Directly sourced from authorized global brands with verified digital serial authentication on delivery."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Shop With Us",
      "blocks": [
        {
          "type": "benefit_card",
          "settings": {
            "icon": "verified",
            "icon_color": "text-primary",
            "title": "100% Genuine Products",
            "description": "Directly sourced from authorized global brands with verified digital serial authentication on delivery."
          }
        },
        {
          "type": "benefit_card",
          "settings": {
            "icon": "lock",
            "icon_color": "text-secondary",
            "title": "Bank-Grade Secure Checkout",
            "description": "256-bit encrypted transactions supporting No-Cost EMI, UPI Instant, Major Cards, and Net Banking."
          }
        },
        {
          "type": "benefit_card",
          "settings": {
            "icon": "electric_bolt",
            "icon_color": "text-primary",
            "title": "Fast & Insured Delivery",
            "description": "Priority dispatch within 6 hours with tamper-proof security seals and comprehensive in-transit insurance."
          }
        },
        {
          "type": "benefit_card",
          "settings": {
            "icon": "sync",
            "icon_color": "text-secondary",
            "title": "7-Day Easy Replacement",
            "description": "Zero-friction doorstep inspection and 1-Year official brand manufacturer replacement warranty assistance."
          }
        }
      ]
    }
  ]
}
{% endschema %}
