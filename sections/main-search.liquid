{%- comment -%}
  NEXORA / TEKNOVA - Main Search Section
  Live search results grid with tab filtering, keyword pills, and product card grid
{%- endcomment -%}

<section class="py-12 bg-surface">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Search Bar Hero -->
    <div class="mb-12 text-center max-w-2xl mx-auto">
      <span class="text-label-sm uppercase font-bold text-primary tracking-wider mb-2 block">
        ARCHITECTURAL CATALOG SEARCH
      </span>
      <h1 class="text-3xl sm:text-headline-lg font-headline-lg font-bold text-on-surface mb-6">
        {%- if search.performed -%}
          Search Results: <span class="text-primary">"{{ search.terms }}"</span>
        {%- else -%}
          Search Our Catalog
        {%- endif -%}
      </h1>

      <div class="relative max-w-xl mx-auto" data-predictive-search-container>
        <form action="{{ routes.search_url }}" method="get" class="flex gap-2">
          <div class="relative flex-1">
            <span class="absolute inset-y-0 left-4 flex items-center pointer-events-none text-on-surface-variant">
              <span class="material-symbols-outlined text-[20px]">search</span>
            </span>
            <input 
              type="search" 
              name="q" 
              value="{{ search.terms | escape }}" 
              placeholder="Search headphones, flagships, OLED, GaN..." 
              class="w-full h-13 pl-11 pr-4 rounded-xl bg-surface-container-lowest border border-outline-variant/60 text-body-md text-on-surface focus:outline-none focus:border-primary shadow-sm"
              autocomplete="off"
              data-predictive-search-input
            />
          </div>
          <button type="submit" class="px-7 h-13 rounded-xl bg-primary hover:bg-primary-container text-on-primary font-bold text-label-md transition-all shadow-md flex items-center gap-1.5 shrink-0">
            <span>Search</span>
            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
          </button>
        </form>

        <div 
          class="absolute left-0 right-0 top-full mt-2 bg-surface-container-lowest border border-outline-variant/40 rounded-2xl shadow-2xl z-50 hidden max-h-96 overflow-y-auto custom-scrollbar text-left"
          data-predictive-search-results
        ></div>
      </div>

      <!-- Suggested Searches -->
      <div class="flex flex-wrap items-center justify-center gap-2 mt-4 text-body-sm text-on-surface-variant">
        <span class="text-label-sm font-semibold">Popular:</span>
        <a href="/search?q=Horizon+Pro" class="px-3 py-1 rounded-full bg-surface-container-low hover:bg-surface-container border border-outline-variant/30 text-label-sm font-medium transition-colors">Horizon Pro 5G</a>
        <a href="/search?q=Headphones" class="px-3 py-1 rounded-full bg-surface-container-low hover:bg-surface-container border border-outline-variant/30 text-label-sm font-medium transition-colors">AuraWave ANC</a>
        <a href="/search?q=Curved+OLED" class="px-3 py-1 rounded-full bg-surface-container-low hover:bg-surface-container border border-outline-variant/30 text-label-sm font-medium transition-colors">Curved OLED</a>
        <a href="/search?q=Titanium" class="px-3 py-1 rounded-full bg-surface-container-low hover:bg-surface-container border border-outline-variant/30 text-label-sm font-medium transition-colors">Titanium Smartwatch</a>
      </div>
    </div>

    {%- if search.performed -%}
      <div class="mb-8 flex items-center justify-between pb-4 border-b border-outline-variant/30">
        <span class="text-label-md font-bold text-on-surface">
          Found {{ search.results_count }} items for "{{ search.terms }}"
        </span>
      </div>

      {%- paginate search.results by 12 -%}
        {%- if search.results.size > 0 -%}
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- else -%}
                <div class="p-6 rounded-2xl bg-surface-container-lowest border border-outline-variant/40 flex flex-col justify-between shadow-sm">
                  <div>
                    <span class="text-label-sm uppercase font-bold text-secondary">{{ item.object_type }}</span>
                    <h3 class="text-headline-sm font-semibold text-on-surface mt-1 mb-2">
                      <a href="{{ item.url }}" class="hover:text-primary transition-colors">{{ item.title }}</a>
                    </h3>
                    <p class="text-body-sm text-on-surface-variant line-clamp-3">
                      {{ item.content | strip_html | truncate: 120 }}
                    </p>
                  </div>
                  <a href="{{ item.url }}" class="text-primary font-semibold hover:underline mt-4 block text-label-md">
                    Read more &rarr;
                  </a>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <div class="mt-12 flex justify-center items-center gap-2">
              {{ paginate | default_pagination: next: '→', previous: '←' }}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="text-center py-20 bg-surface-container-lowest rounded-3xl border border-outline-variant/30 max-w-xl mx-auto p-8 shadow-sm">
            <span class="material-symbols-outlined text-[56px] text-on-surface-variant/40 mb-3">search_off</span>
            <h2 class="text-headline-sm font-bold text-on-surface mb-2">No results matched your search</h2>
            <p class="text-body-md text-on-surface-variant mb-6">Try searching for keywords like "audio", "foldable", "smartwatch", or "laptop".</p>
            <a href="{{ routes.all_products_collection_url }}" class="inline-flex px-8 py-3 rounded-xl bg-primary text-on-primary font-bold text-label-md shadow-md hover:bg-primary-container transition-all">
              Browse Full Catalog
            </a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search Results",
  "settings": []
}
{% endschema %}
