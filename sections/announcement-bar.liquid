{%- comment -%}
  NEXORA / TEKNOVA - Section 1: Top Announcement Bar
  Multi-message ticker + currency & utility selectors
{%- endcomment -%}

{%- if section.settings.show_announcement_bar -%}
  <aside 
    class="bg-inverse-surface text-inverse-on-surface text-label-sm font-label-sm border-b border-outline/20 sticky top-0 z-50"
    data-announcement-bar
    data-interval="{{ section.settings.cycle_interval | default: 4000 }}"
  >
    <div class="max-w-7xl mx-auto px-6 h-9 flex items-center justify-between">
      <!-- Left & Center Ticker -->
      <div class="flex items-center space-x-4 sm:space-x-6 overflow-hidden">
        {%- if section.settings.badge_text != blank -%}
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-primary/20 text-inverse-primary border border-primary/30 uppercase tracking-widest text-[9px] font-bold shrink-0">
            {{ section.settings.badge_text }}
          </span>
        {%- endif -%}

        <div class="relative flex items-center overflow-hidden h-6">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <div 
                class="flex items-center gap-2 transition-opacity duration-300 {% unless forloop.first %}hidden{% endunless %}" 
                data-announcement-item
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.icon != blank -%}
                  <span class="material-symbols-outlined text-[14px] text-secondary-fixed shrink-0">
                    {{ block.settings.icon }}
                  </span>
                {%- endif -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="tracking-wide hover:underline truncate">
                    {{ block.settings.text }}
                  </a>
                {%- else -%}
                  <span class="tracking-wide truncate">
                    {{ block.settings.text }}
                  </span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="flex items-center gap-2" data-announcement-item>
              <span class="material-symbols-outlined text-[14px] text-secondary-fixed shrink-0">local_shipping</span>
              <span class="tracking-wide">Free Express Shipping on orders above ₹999</span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- Right Utility Actions -->
      <div class="flex items-center space-x-3 sm:space-x-5 text-inverse-on-surface/80 shrink-0 text-xs sm:text-label-sm">
        {%- if section.settings.show_currency -%}
          <div class="flex items-center space-x-1 hover:text-inverse-on-surface cursor-pointer transition-colors">
            <span class="material-symbols-outlined text-[15px]">{{ section.settings.currency_icon | default: 'currency_rupee' }}</span>
            <span>{{ section.settings.currency_label | default: 'INR (₹)' }}</span>
            <span class="material-symbols-outlined text-[14px]">expand_more</span>
          </div>
        {%- endif -%}

        {%- if section.settings.store_locator_label != blank -%}
          <span class="text-outline/40">|</span>
          <a class="flex items-center space-x-1 hover:text-inverse-on-surface transition-colors" href="{{ section.settings.store_locator_url | default: '#store-locator' }}">
            <span class="material-symbols-outlined text-[15px]">storefront</span>
            <span class="hidden sm:inline">{{ section.settings.store_locator_label }}</span>
          </a>
        {%- endif -%}

        {%- if section.settings.support_label != blank -%}
          <span class="text-outline/40">|</span>
          <a class="flex items-center space-x-1 hover:text-inverse-on-surface transition-colors" href="{{ section.settings.support_url | default: '#support' }}">
            <span class="material-symbols-outlined text-[15px]">headset_mic</span>
            <span class="hidden sm:inline">{{ section.settings.support_label }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement_bar",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "LIVE DIRECT"
    },
    {
      "type": "range",
      "id": "cycle_interval",
      "label": "Rotation Interval (ms)",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "default": 4000
    },
    {
      "type": "header",
      "content": "Utility Links"
    },
    {
      "type": "checkbox",
      "id": "show_currency",
      "label": "Show Currency Selector",
      "default": true
    },
    {
      "type": "text",
      "id": "currency_label",
      "label": "Currency Label",
      "default": "INR (₹)"
    },
    {
      "type": "text",
      "id": "currency_icon",
      "label": "Currency Icon (Material Symbol)",
      "default": "currency_rupee"
    },
    {
      "type": "text",
      "id": "store_locator_label",
      "label": "Store Locator Label",
      "default": "Store Locator"
    },
    {
      "type": "url",
      "id": "store_locator_url",
      "label": "Store Locator Link"
    },
    {
      "type": "text",
      "id": "support_label",
      "label": "Support Label",
      "default": "24/7 Support"
    },
    {
      "type": "url",
      "id": "support_url",
      "label": "Support Link"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message Text",
          "default": "Free Express Shipping on orders above ₹999"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Material Symbol Icon",
          "default": "local_shipping"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Free Express Shipping on orders above ₹999",
            "icon": "local_shipping"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Limited-Time Festive Offer: Get 10% instant cashback with premium cards",
            "icon": "bolt"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Hassle-free 7-Day Replacement & 1-Year Official Warranty",
            "icon": "verified_user"
          }
        }
      ]
    }
  ]
}
{% endschema %}
