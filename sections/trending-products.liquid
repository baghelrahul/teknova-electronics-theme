{%- comment -%}
  NEXORA / TEKNOVA - Section 5: Trending Products
  5-column product showcase with category filter tabs
{%- endcomment -%}

<section class="py-20 bg-surface-container-lowest border-y border-outline-variant/30" id="trending" data-tabs-container>
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8">
      <div>
        <span class="text-label-md font-label-md uppercase tracking-wider text-secondary font-semibold">
          {{ section.settings.eyebrow | default: 'Real-Time Demand' }}
        </span>
        <h2 class="text-headline-lg font-headline-lg text-on-surface mt-1">
          {{ section.settings.heading | default: 'Trending Right Now' }}
        </h2>
      </div>

      <!-- Filter Tabs -->
      <div class="flex items-center gap-1.5 p-1 bg-surface-container-low rounded-xl mt-4 md:mt-0 overflow-x-auto custom-scrollbar">
        <button type="button" class="px-4 py-2 rounded-lg bg-surface-container-lowest text-on-surface font-label-md text-label-md font-semibold shadow-sm shrink-0" data-tab-button data-tab-target="all">
          All Trending
        </button>
        <button type="button" class="px-4 py-2 rounded-lg text-on-surface-variant hover:text-on-surface font-label-md text-label-md font-medium shrink-0" data-tab-button data-tab-target="phones">
          Flagship Phones
        </button>
        <button type="button" class="px-4 py-2 rounded-lg text-on-surface-variant hover:text-on-surface font-label-md text-label-md font-medium shrink-0" data-tab-button data-tab-target="audio">
          Hi-Fi Audio
        </button>
        <button type="button" class="px-4 py-2 rounded-lg text-on-surface-variant hover:text-on-surface font-label-md text-label-md font-medium shrink-0" data-tab-button data-tab-target="wearables">
          Wearables
        </button>
        <button type="button" class="px-4 py-2 rounded-lg text-on-surface-variant hover:text-on-surface font-label-md text-label-md font-medium shrink-0" data-tab-button data-tab-target="laptops">
          Laptops
        </button>
      </div>
    </div>

    <!-- 5 Column Grid for Desktop -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
      {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          <div data-tab-panel data-tab-category="all">
            {% render 'product-card', product: product %}
          </div>
        {%- endfor -%}
      {%- elsif section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div data-tab-panel data-tab-category="{{ block.settings.tab_category | default: 'all' }}" {{ block.shopify_attributes }}>
            {% render 'product-card',
              title: block.settings.title,
              subtitle: block.settings.subtitle,
              price: block.settings.price,
              compare_price: block.settings.compare_price,
              rating: block.settings.rating,
              reviews_count: block.settings.reviews_count,
              badge: block.settings.badge,
              badge_color: block.settings.badge_color,
              image_url: block.settings.image_url,
              swatches: block.settings.swatches,
              url: block.settings.url
            %}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

