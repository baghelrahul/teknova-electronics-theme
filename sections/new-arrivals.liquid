{%- comment -%}
  NEXORA / TEKNOVA - Section 8: New Arrivals ('Fresh Tech Has Arrived' Reel)
  Hardware releases reel with category tags and navigation controls
{%- endcomment -%}

<section class="py-20 bg-surface">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-end justify-between mb-10">
      <div>
        <span class="text-label-md font-label-md uppercase tracking-wider text-secondary font-semibold">
          {{ section.settings.eyebrow | default: 'First Edition Releases' }}
        </span>
        <h2 class="text-headline-lg font-headline-lg text-on-surface mt-1">
          {{ section.settings.heading | default: 'Fresh Tech Has Arrived' }}
        </h2>
      </div>

      <!-- Navigation Reel Controls -->
      <div class="flex items-center gap-2">
        <button type="button" class="w-10 h-10 rounded-full border border-outline-variant/60 flex items-center justify-center hover:bg-surface-container transition-colors" title="Previous">
          <span class="material-symbols-outlined text-[20px]">chevron_left</span>
        </button>
        <button type="button" class="w-10 h-10 rounded-full bg-inverse-surface text-inverse-on-surface flex items-center justify-center hover:bg-primary transition-colors" title="Next">
          <span class="material-symbols-outlined text-[20px]">chevron_right</span>
        </button>
      </div>
    </div>

    <!-- Cards Container -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="rounded-2xl bg-surface-container-lowest border border-outline-variant/40 p-4 flex flex-col justify-between" {{ block.shopify_attributes }}>
            <div>
              <div class="aspect-[4/3] rounded-xl bg-surface-container-low overflow-hidden mb-3">
                <img 
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" 
                  src="{{ block.settings.image_url }}" 
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                />
              </div>
              <span class="text-label-sm font-label-sm text-primary font-bold">{{ block.settings.tag }}</span>
              <h4 class="text-headline-sm font-headline-sm text-on-surface text-[17px] mt-1">{{ block.settings.title }}</h4>
              <p class="text-body-sm font-body-sm text-on-surface-variant">{{ block.settings.description }}</p>
            </div>
            <div class="mt-4 flex items-center justify-between pt-3 border-t border-outline-variant/20">
              <span class="font-bold text-on-surface">{{ block.settings.price }}</span>
              <a href="{{ block.settings.link | default: '#' }}" class="text-primary font-label-md text-label-md font-semibold hover:underline">
                Explore →
              </a>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

