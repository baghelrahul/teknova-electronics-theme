{%- comment -%}
  NEXORA / TEKNOVA - Section 6: Promotional Banner
  Split showcase with dark glassmorphism styling, specs tags, and perks
{%- endcomment -%}

<section class="py-16 bg-surface">
  <div class="max-w-7xl mx-auto px-6">
    <div class="relative rounded-3xl bg-inverse-surface overflow-hidden border border-outline/30 text-inverse-on-surface p-8 md:p-16 flex flex-col lg:flex-row items-center justify-between gap-12">
      <!-- Radiant Glow Backdrop -->
      <div class="absolute -right-20 -bottom-20 w-[500px] h-[500px] bg-primary/20 blur-3xl rounded-full pointer-events-none"></div>

      <div class="lg:w-1/2 relative z-10">
        <!-- Specs Tag Row -->
        <div class="flex flex-wrap gap-2 mb-6">
          {%- if section.settings.tag_1 != blank -%}
            <span class="px-3 py-1 rounded-full bg-inverse-on-surface/10 border border-inverse-on-surface/20 text-inverse-primary text-label-sm font-label-sm font-semibold">
              {{ section.settings.tag_1 }}
            </span>
          {%- endif -%}
          {%- if section.settings.tag_2 != blank -%}
            <span class="px-3 py-1 rounded-full bg-inverse-on-surface/10 border border-inverse-on-surface/20 text-inverse-primary text-label-sm font-label-sm font-semibold">
              {{ section.settings.tag_2 }}
            </span>
          {%- endif -%}
          {%- if section.settings.tag_3 != blank -%}
            <span class="px-3 py-1 rounded-full bg-inverse-on-surface/10 border border-inverse-on-surface/20 text-inverse-primary text-label-sm font-label-sm font-semibold">
              {{ section.settings.tag_3 }}
            </span>
          {%- endif -%}
        </div>

        <h2 class="text-3xl md:text-headline-lg font-headline-lg font-bold tracking-tight mb-4">
          {{ section.settings.heading_line_1 | default: 'Next-Level Audio.' }} <br/>
          <span class="text-inverse-primary">{{ section.settings.heading_highlight | default: 'Zero Distractions.' }}</span>
        </h2>

        <p class="text-body-lg font-body-lg text-inverse-on-surface/80 max-w-lg mb-8">
          {{ section.settings.description | default: 'Immerse yourself in acoustic perfection calibrated with precision planar magnetic transducers and custom beryllium acoustic chambers.' }}
        </p>

        <div class="flex flex-wrap items-center gap-4">
          {%- if section.settings.button_text != blank -%}
            <a 
              class="h-12 px-7 rounded-lg bg-primary hover:bg-primary-container text-on-primary transition-all duration-200 flex items-center gap-2 font-label-md text-label-md font-semibold shadow-lg" 
              href="{{ section.settings.button_link | default: '#audio-architecture' }}"
            >
              <span>{{ section.settings.button_text }}</span>
              <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
          {%- endif -%}

          {%- if section.settings.perk_text != blank -%}
            <span class="px-3 py-2 rounded-lg bg-surface-container-lowest/10 backdrop-blur-md border border-white/10 text-inverse-on-surface/90 text-label-sm font-label-sm">
              {{ section.settings.perk_text }}
            </span>
          {%- endif -%}
        </div>
      </div>

      <div class="lg:w-1/2 relative z-10 flex justify-center">
        <div class="w-full max-w-md aspect-square rounded-2xl overflow-hidden border border-white/10 bg-white/5 backdrop-blur-sm p-4">
          {%- if section.settings.image != blank -%}
            <img 
              class="w-full h-full object-cover rounded-xl" 
              src="{{ section.settings.image | image_url: width: 900 }}" 
              alt="{{ section.settings.heading_line_1 | escape }}"
              loading="lazy"
            />
          {%- else -%}
            <img 
              class="w-full h-full object-cover rounded-xl" 
              alt="Audiophile wireless headphones floating in studio with violet rim lighting" 
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuAX1y9Gw5XoQg3_XFaHwJFYBx7J3UDxE0PDq-J4RYjCIr334Jk_sP8IHyA1lXBkC1q38G-dL05q8IGFCxmp-JgDuRzC8g5EeiAU2SCic-yv-yQG6ZmTXgjJK-bfBs2PvzKGrPX_WAbQydL1pDBg6LLF1WL0oYMbt6hxb1Dm1cIeRWDLlQk1NEbX2Bflz2SP3_WRPI_wnV35ZJ87fPzn7Lq8pdVSVaTvaNNB6e-GWWU"
              loading="lazy"
            />
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promotional Banner",
  "settings": [
    {
      "type": "text",
      "id": "tag_1",
      "label": "Tag 1",
      "default": "48-bit Hi-Res DAC"
    },
    {
      "type": "text",
      "id": "tag_2",
      "label": "Tag 2",
      "default": "Adaptive Hybrid ANC"
    },
    {
      "type": "text",
      "id": "tag_3",
      "label": "Tag 3",
      "default": "Ultra-Low 15ms"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading Line 1",
      "default": "Next-Level Audio."
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading Highlight",
      "default": "Zero Distractions."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Immerse yourself in acoustic perfection calibrated with precision planar magnetic transducers and custom beryllium acoustic chambers."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Explore Audio Architecture"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "perk_text",
      "label": "Complimentary Perk Text",
      "default": "🎁 Complimentary 6-Mo Lossless Music"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Visual"
    }
  ],
  "presets": [
    {
      "name": "Promotional Banner"
    }
  ]
}
{% endschema %}
