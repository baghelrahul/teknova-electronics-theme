                image_url: 'https://lh3.googleusercontent.com/aida-public/AB6AXuCl5ySv51hpH5e1Q8FPt1ca9lsDfjmcN8Ju4SX29gTsg-Lyqg75qkQwcWin3occxQMVxFCyVdSvd8hbqlOqQJH9j8WAn_zbEwLBovhQg58mlM6AvyuVnaHAMEX7NGCYHdDa6BLOzvPAOeZRvtWGqQ0frXbIu-cHhdOApwXDQ4b08nHFl188xe7wpzeJTmxDbBj5FZBv9tXz_AZk7HEknyxQcME0zDiU7wssR2eNOWM'
              %}
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
  </div>
</section>

<!-- Mobile Filter Drawer Backdrop -->
<div 
  id="mobile-filter-backdrop" 
  class="fixed inset-0 bg-black/50 z-50 hidden transition-opacity duration-300" 
  onclick="this.classList.add('hidden'); document.getElementById('mobile-filter-drawer').classList.add('translate-x-full');"
></div>

<!-- Mobile Filter Drawer -->
<div 
  id="mobile-filter-drawer" 
  class="fixed top-0 right-0 w-80 max-w-[85vw] h-full bg-surface z-50 transform translate-x-full transition-transform duration-300 shadow-2xl flex flex-col justify-between p-6"
>
  <div>
    <div class="flex items-center justify-between pb-4 border-b border-outline-variant/30 mb-6">
      <h3 class="text-headline-sm font-bold text-on-surface">Filters</h3>
      <button 
        type="button" 
        class="p-2 text-on-surface-variant hover:text-primary" 
        onclick="document.getElementById('mobile-filter-drawer').classList.add('translate-x-full'); document.getElementById('mobile-filter-backdrop').classList.add('hidden');"
      >
        <span class="material-symbols-outlined text-[22px]">close</span>
      </button>
    </div>

    <!-- Mobile Mirror of Filters -->
    <div class="space-y-6 overflow-y-auto max-h-[75vh] pr-1">
      <!-- Mobile Price Filter -->
      <div>
        <h4 class="text-label-md font-bold uppercase text-on-surface mb-2">Price (₹)</h4>
        <div class="flex items-center gap-2 mb-2">
          <input 
            type="number" 
            id="mobile-filter-price-min" 
            placeholder="Min" 
            class="w-full h-9 px-2 rounded-lg bg-surface-container-low border border-outline-variant/40 text-body-sm font-mono"
            oninput="document.getElementById('filter-price-min').value = this.value; nexoraFilterEngine.onPriceInput();"
          >
          <span class="text-on-surface-variant">-</span>
          <input 
            type="number" 
            id="mobile-filter-price-max" 
            placeholder="Max" 
            class="w-full h-9 px-2 rounded-lg bg-surface-container-low border border-outline-variant/40 text-body-sm font-mono"
            oninput="document.getElementById('filter-price-max').value = this.value; nexoraFilterEngine.onPriceInput();"
          >
        </div>
      </div>

      <!-- Mobile Tags Filter -->
      {%- if collection.all_tags.size > 0 -%}
        <div>
          <h4 class="text-label-md font-bold uppercase text-on-surface mb-2">Tags / Specs</h4>
          <div class="space-y-2 max-h-48 overflow-y-auto">
            {%- for tag in collection.all_tags -%}
              {%- assign tag_lower = tag | downcase -%}
              <label class="flex items-center gap-2 text-body-sm text-on-surface">
                <input 
                  type="checkbox" 
                  value="{{ tag_lower }}" 
                  data-mobile-filter-tag
                  class="rounded text-primary"
                  onchange="nexoraFilterEngine.syncMobileFilter('tag', '{{ tag_lower }}', this.checked);"
                >
                <span class="capitalize">{{ tag }}</span>
              </label>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <!-- Mobile Category Filter -->
      {%- if collection.all_types.size > 0 -%}
        <div>
          <h4 class="text-label-md font-bold uppercase text-on-surface mb-2">Category</h4>
          <div class="space-y-2 max-h-40 overflow-y-auto">
            {%- for type in collection.all_types -%}
              {%- if type != blank -%}
                {%- assign type_lower = type | downcase -%}
                <label class="flex items-center gap-2 text-body-sm text-on-surface">
                  <input 
                    type="checkbox" 
                    value="{{ type_lower }}" 
                    data-mobile-filter-type
                    class="rounded text-primary"
                    onchange="nexoraFilterEngine.syncMobileFilter('type', '{{ type_lower }}', this.checked);"
                  >
                  <span>{{ type }}</span>
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="pt-4 border-t border-outline-variant/30 flex gap-2">
    <button 
      type="button" 
      class="flex-1 h-11 rounded-xl bg-surface-container text-on-surface font-semibold text-label-md" 
      onclick="nexoraFilterEngine.clearAll();"
    >
      Reset
    </button>
    <button 
      type="button" 
      class="flex-1 h-11 rounded-xl bg-primary text-on-primary font-bold text-label-md shadow-md" 
      onclick="document.getElementById('mobile-filter-drawer').classList.add('translate-x-full'); document.getElementById('mobile-filter-backdrop').classList.add('hidden');"
    >
      View Results
    </button>
  </div>
</div>

<!-- Reactive Dynamic Filter Engine Script -->
<script>
  window.nexoraFilterEngine = (function() {
    let priceTimeout = null;

    function getCards() {
      return Array.from(document.querySelectorAll('#CollectionProductGrid [data-product-card]'));
    }

    function getSelectedTags() {
      return Array.from(document.querySelectorAll('input[data-filter-tag]:checked')).map(el => el.value.toLowerCase().trim());
    }

    function getSelectedTypes() {
      return Array.from(document.querySelectorAll('input[data-filter-type]:checked')).map(el => el.value.toLowerCase().trim());
    }

    function getSelectedVendors() {
      return Array.from(document.querySelectorAll('input[data-filter-vendor]:checked')).map(el => el.value.toLowerCase().trim());
    }

    function getAvailability() {
      const el = document.querySelector('input[data-filter-available]');
      return el && el.checked;
    }

    function getPriceRange() {
      const minEl = document.getElementById('filter-price-min');
      const maxEl = document.getElementById('filter-price-max');
      const min = minEl && minEl.value !== '' ? parseFloat(minEl.value) : null;
      const max = maxEl && maxEl.value !== '' ? parseFloat(maxEl.value) : null;
      return { min, max };
    }

    function filterProducts() {
      const cards = getCards();
      const tags = getSelectedTags();
      const types = getSelectedTypes();
      const vendors = getSelectedVendors();
      const onlyAvailable = getAvailability();
      const { min: minPrice, max: maxPrice } = getPriceRange();

      let visibleCount = 0;

      cards.forEach(card => {
        const rawPrice = parseFloat(card.dataset.productPriceRaw || '0');
        const cardTags = (card.dataset.productTags || '').toLowerCase().split(',').map(s => s.trim());
        const cardType = (card.dataset.productType || '').toLowerCase().trim();
        const cardVendor = (card.dataset.productVendor || '').toLowerCase().trim();
        const cardAvailable = card.dataset.productAvailable === 'true';

        let matches = true;

        // Price check
        if (minPrice !== null && !isNaN(minPrice) && rawPrice < minPrice) {
          matches = false;
        }
        if (maxPrice !== null && !isNaN(maxPrice) && rawPrice > maxPrice) {
          matches = false;
        }

        // Tags check (must match at least one selected tag if tags selected)
        if (tags.length > 0) {
          const hasTag = tags.some(t => cardTags.includes(t));
          if (!hasTag) matches = false;
        }

        // Type check
        if (types.length > 0) {
          if (!types.includes(cardType)) matches = false;
        }

        // Vendor check
        if (vendors.length > 0) {
          if (!vendors.includes(cardVendor)) matches = false;
        }

        // Availability check
        if (onlyAvailable && !cardAvailable) {
          matches = false;
        }

        // Toggle card display
        if (matches) {
          card.classList.remove('hidden');
          card.style.display = '';
          visibleCount++;
        } else {
          card.classList.add('hidden');
          card.style.display = 'none';
        }
      });

      // Update counters
      const countEl = document.getElementById('visible-count');
      if (countEl) countEl.textContent = visibleCount;

      const emptyEl = document.getElementById('filter-empty-state');
      const gridEl = document.getElementById('CollectionProductGrid');
      if (emptyEl) {
        if (visibleCount === 0 && cards.length > 0) {
          emptyEl.classList.remove('hidden');
          if (gridEl) gridEl.classList.add('hidden');
        } else {
          emptyEl.classList.add('hidden');
          if (gridEl) gridEl.classList.remove('hidden');
        }
      }

      updateActiveChips();
      syncMobileBadges();
      updateUrlState();
    }

    function updateActiveChips() {
      const bar = document.getElementById('active-filters-bar');
      const container = document.getElementById('active-chips-container');
      if (!bar || !container) return;

      container.innerHTML = '';
      let chipCount = 0;

      const { min, max } = getPriceRange();
      if (min !== null || max !== null) {
        chipCount++;
        const label = (min ? '₹' + min : '₹0') + ' - ' + (max ? '₹' + max : 'Any');
        container.appendChild(createChip('Price: ' + label, () => {
          document.getElementById('filter-price-min').value = '';
          document.getElementById('filter-price-max').value = '';
          const mMin = document.getElementById('mobile-filter-price-min');
          const mMax = document.getElementById('mobile-filter-price-max');
          if (mMin) mMin.value = '';
          if (mMax) mMax.value = '';
          filterProducts();
        }));
      }

      getSelectedTags().forEach(tag => {
        chipCount++;
        container.appendChild(createChip('Tag: ' + tag, () => {
          document.querySelectorAll(`input[data-filter-tag][value="${tag}"]`).forEach(el => el.checked = false);
          document.querySelectorAll(`input[data-mobile-filter-tag][value="${tag}"]`).forEach(el => el.checked = false);
          filterProducts();
        }));
      });

      getSelectedTypes().forEach(type => {
        chipCount++;
        container.appendChild(createChip('Category: ' + type, () => {
          document.querySelectorAll(`input[data-filter-type][value="${type}"]`).forEach(el => el.checked = false);
          document.querySelectorAll(`input[data-mobile-filter-type][value="${type}"]`).forEach(el => el.checked = false);
          filterProducts();
        }));
      });

      getSelectedVendors().forEach(vendor => {
        chipCount++;
        container.appendChild(createChip('Brand: ' + vendor, () => {
          document.querySelectorAll(`input[data-filter-vendor][value="${vendor}"]`).forEach(el => el.checked = false);
          filterProducts();
        }));
      });

      if (getAvailability()) {
        chipCount++;
        container.appendChild(createChip('In Stock Only', () => {
          const el = document.querySelector('input[data-filter-available]');
          if (el) el.checked = false;
          filterProducts();
        }));
      }

      if (chipCount > 0) {
        bar.classList.remove('hidden');
        bar.classList.add('flex');
      } else {
        bar.classList.add('hidden');
        bar.classList.remove('flex');
      }
    }

    function createChip(text, onRemove) {
      const chip = document.createElement('span');
      chip.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary text-[12px] font-semibold hover:bg-primary/20 transition-colors shadow-2xs';
      chip.innerHTML = `<span>${text}</span><button type="button" class="material-symbols-outlined text-[14px] hover:text-rose-500 cursor-pointer">close</button>`;
      chip.querySelector('button').addEventListener('click', onRemove);
      return chip;
    }

    function syncMobileBadges() {
      const totalActive = getSelectedTags().length + getSelectedTypes().length + getSelectedVendors().length + (getAvailability() ? 1 : 0) + (getPriceRange().min || getPriceRange().max ? 1 : 0);
      const badge = document.getElementById('mobile-filter-count-badge');
      if (badge) {
        if (totalActive > 0) {
          badge.textContent = totalActive;
          badge.classList.remove('hidden');
        } else {
          badge.classList.add('hidden');
        }
      }
    }

    function updateUrlState() {
      try {
        const url = new URL(window.location.href);
        const { min, max } = getPriceRange();
        if (min !== null && !isNaN(min)) url.searchParams.set('filter.v.price.gte', min);
        else url.searchParams.delete('filter.v.price.gte');

        if (max !== null && !isNaN(max)) url.searchParams.set('filter.v.price.lte', max);
        else url.searchParams.delete('filter.v.price.lte');

        const tags = getSelectedTags();
        if (tags.length > 0) url.searchParams.set('tags', tags.join(','));
        else url.searchParams.delete('tags');

        const types = getSelectedTypes();
        if (types.length > 0) url.searchParams.set('types', types.join(','));
        else url.searchParams.delete('types');

        window.history.replaceState({}, '', url.toString());
      } catch (e) {}
    }

    function restoreFromUrl() {
      try {
        const params = new URLSearchParams(window.location.search);
        const min = params.get('filter.v.price.gte');
        const max = params.get('filter.v.price.lte');
        const tags = params.get('tags') ? params.get('tags').split(',') : [];
        const types = params.get('types') ? params.get('types').split(',') : [];

        if (min) {
          const el = document.getElementById('filter-price-min');
          if (el) el.value = min;
          const mEl = document.getElementById('mobile-filter-price-min');
          if (mEl) mEl.value = min;
        }
        if (max) {
          const el = document.getElementById('filter-price-max');
          if (el) el.value = max;
          const mEl = document.getElementById('mobile-filter-price-max');
          if (mEl) mEl.value = max;
        }

        tags.forEach(t => {
          const el = document.querySelector(`input[data-filter-tag][value="${t.trim().toLowerCase()}"]`);
          if (el) el.checked = true;
          const mEl = document.querySelector(`input[data-mobile-filter-tag][value="${t.trim().toLowerCase()}"]`);
          if (mEl) mEl.checked = true;
        });

        types.forEach(ty => {
          const el = document.querySelector(`input[data-filter-type][value="${ty.trim().toLowerCase()}"]`);
          if (el) el.checked = true;
          const mEl = document.querySelector(`input[data-mobile-filter-type][value="${ty.trim().toLowerCase()}"]`);
          if (mEl) mEl.checked = true;
        });

        filterProducts();
      } catch (e) {}
    }

    return {
      onPriceInput: function() {
        clearTimeout(priceTimeout);
        priceTimeout = setTimeout(filterProducts, 300);
      },
      applyPriceFilter: function() {
        filterProducts();
      },
      setPricePreset: function(min, max) {
        const minEl = document.getElementById('filter-price-min');
        const maxEl = document.getElementById('filter-price-max');
        if (minEl) minEl.value = min;
        if (maxEl) maxEl.value = max;
        const mMin = document.getElementById('mobile-filter-price-min');
        const mMax = document.getElementById('mobile-filter-price-max');
        if (mMin) mMin.value = min;
        if (mMax) mMax.value = max;
        filterProducts();
      },
      onFilterChange: function() {
        filterProducts();
      },
      syncMobileFilter: function(kind, val, isChecked) {
        if (kind === 'tag') {
          const el = document.querySelector(`input[data-filter-tag][value="${val}"]`);
          if (el) el.checked = isChecked;
        } else if (kind === 'type') {
          const el = document.querySelector(`input[data-filter-type][value="${val}"]`);
          if (el) el.checked = isChecked;
        }
        filterProducts();
      },
      handleSort: function(val) {
        const cards = getCards();
        const grid = document.getElementById('CollectionProductGrid');
        if (!grid) return;

        if (val === 'price-ascending') {
          cards.sort((a, b) => parseFloat(a.dataset.productPriceRaw || 0) - parseFloat(b.dataset.productPriceRaw || 0));
        } else if (val === 'price-descending') {
          cards.sort((a, b) => parseFloat(b.dataset.productPriceRaw || 0) - parseFloat(a.dataset.productPriceRaw || 0));
        } else if (val === 'best-selling') {
          cards.sort((a, b) => (b.dataset.productTags || '').includes('bestseller') ? 1 : -1);
        }

        cards.forEach(c => grid.appendChild(c));
      },
      clearAll: function() {
        document.querySelectorAll('input[type="checkbox"]').forEach(c => c.checked = false);
        const minEl = document.getElementById('filter-price-min');
        const maxEl = document.getElementById('filter-price-max');
        if (minEl) minEl.value = '';
        if (maxEl) maxEl.value = '';
        const mMin = document.getElementById('mobile-filter-price-min');
        const mMax = document.getElementById('mobile-filter-price-max');
        if (mMin) mMin.value = '';
        if (mMax) mMax.value = '';
        filterProducts();
      },
      init: function() {
        restoreFromUrl();
      }
    };
  })();

  document.addEventListener('DOMContentLoaded', function() {
    window.nexoraFilterEngine.init();
  });
</script>

{% schema %}
{
  "name": "Collection Grid & Filters",
  "settings": []
}
{% endschema %}