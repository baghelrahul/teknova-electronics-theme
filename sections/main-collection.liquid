{%- comment -%}
  NEXORA / TEKNOVA - Main Collection Section
  Dynamic backend filters in left sidebar + product card grid + sorting & pagination
{%- endcomment -%}

<section class="py-12 bg-surface">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Header Bar -->
    <div class="mb-8 pb-6 border-b border-outline-variant/30 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <nav class="flex items-center space-x-2 text-label-sm font-label-sm text-on-surface-variant mb-2">
          <a href="{{ routes.root_url }}" class="hover:text-primary">Home</a>
          <span>/</span>
          <span class="text-on-surface font-semibold">{{ collection.title }}</span>
        </nav>
        <h1 class="text-3xl sm:text-headline-lg font-headline-lg font-bold text-on-surface">
          {{ collection.title }}
        </h1>
        {%- if collection.description != blank -%}
          <p class="text-body-md font-body-md text-on-surface-variant mt-2 max-w-2xl">
            {{ collection.description }}
          </p>
        {%- endif -%}
      </div>

      <!-- Sorting & Mobile Filter Toggle -->
      <div class="flex items-center gap-3">
        <!-- Mobile Filter Button -->
        <button 
          type="button" 
          class="lg:hidden flex items-center gap-2 px-4 py-2.5 rounded-xl bg-surface-container-lowest border border-outline-variant/40 text-label-md font-semibold text-on-surface"
          onclick="document.getElementById('mobile-filter-drawer').classList.remove('translate-x-full'); document.getElementById('mobile-filter-backdrop').classList.remove('hidden');"
        >
          <span class="material-symbols-outlined text-[18px]">filter_list</span>
          <span>Filters</span>
        </button>

        <!-- Sort By Dropdown -->
        <div class="relative">
          <select 
            id="SortBy" 
            name="sort_by" 
            class="h-10 pl-3 pr-8 rounded-xl bg-surface-container-lowest border border-outline-variant/40 text-label-md font-label-md text-on-surface focus:outline-none focus:border-primary cursor-pointer"
            onchange="location.href = window.location.pathname + '?' + new URLSearchParams(Object.assign(Object.fromEntries(new URLSearchParams(window.location.search)), {sort_by: this.value})).toString();"
          >
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            <option value="manual" {% if sort_by == 'manual' %}selected{% endif %}>Featured Hardware</option>
            <option value="best-selling" {% if sort_by == 'best-selling' %}selected{% endif %}>Best Selling</option>
            <option value="price-ascending" {% if sort_by == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
            <option value="price-descending" {% if sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
            <option value="created-descending" {% if sort_by == 'created-descending' %}selected{% endif %}>Newest Releases</option>
          </select>
        </div>

        <span class="text-label-md font-label-md text-on-surface-variant bg-surface-container px-3 py-1.5 rounded-full shrink-0">
          {{ collection.products_count }} Products
        </span>
      </div>
    </div>

    <!-- Active Filter Tags Row -->
    {%- assign has_active_filter = false -%}
    {%- for filter in collection.filters -%}
      {%- if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil -%}
        {%- assign has_active_filter = true -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_active_filter -%}
      <div class="flex flex-wrap items-center gap-2 mb-6">
        <span class="text-label-sm font-semibold text-on-surface-variant mr-1">Active Filters:</span>
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <a href="{{ value.url_to_remove }}" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary text-label-sm font-semibold hover:bg-primary/20 transition-colors">
              <span>{{ filter.label }}: {{ value.label }}</span>
              <span class="material-symbols-outlined text-[14px]">close</span>
            </a>
          {%- endfor -%}
        {%- endfor -%}
        <a href="{{ collection.url }}" class="text-label-sm font-bold text-rose-500 hover:underline ml-2">
          Clear All
        </a>
      </div>
    {%- endif -%}

    <!-- Main Grid with Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Desktop Sidebar Filters -->
      <aside class="hidden lg:block lg:col-span-3 rounded-2xl bg-surface-container-lowest border border-outline-variant/40 p-6 sticky top-28 space-y-6 shadow-sm">
        <div class="flex items-center justify-between pb-4 border-b border-outline-variant/30">
          <h3 class="text-headline-sm font-bold text-on-surface text-[17px] flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px] text-primary">tune</span>
            <span>Filter Hardware</span>
          </h3>
          {%- if has_active_filter -%}
            <a href="{{ collection.url }}" class="text-label-sm text-primary hover:underline font-semibold">Reset</a>
          {%- endif -%}
        </div>

        <form id="CollectionFiltersForm" class="space-y-6">
          {%- for filter in collection.filters -%}
            <div class="pb-5 border-b border-outline-variant/20 last:border-b-0 last:pb-0">
              <h4 class="text-label-md font-label-md font-bold uppercase text-on-surface mb-3 flex items-center justify-between">
                <span>{{ filter.label }}</span>
                {%- if filter.active_values.size > 0 -%}
                  <span class="text-[11px] text-primary font-bold">({{ filter.active_values.size }})</span>
                {%- endif -%}
              </h4>

              {%- case filter.type -%}
                {%- when 'list' -%}
                  <div class="space-y-2.5 max-h-56 overflow-y-auto custom-scrollbar pr-1">
                    {%- for value in filter.values -%}
                      <label class="flex items-center justify-between text-body-sm text-on-surface cursor-pointer hover:text-primary group">
                        <div class="flex items-center gap-2.5">
                          <input 
                            type="checkbox" 
                            name="{{ value.param_name }}" 
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                            class="rounded border-outline-variant text-primary focus:ring-primary w-4 h-4 cursor-pointer"
                            onchange="this.form.submit();"
                          >
                          <span class="group-hover:text-primary {% if value.active %}font-bold text-primary{% endif %}">{{ value.label }}</span>
                        </div>
                        <span class="text-xs text-on-surface-variant/70">({{ value.count }})</span>
                      </label>
                    {%- endfor -%}
                  </div>

                {%- when 'price_range' -%}
                  <div class="space-y-3">
                    <div class="flex items-center gap-2 text-body-sm text-on-surface">
                      <div class="flex-1">
                        <label class="text-[10px] text-on-surface-variant uppercase font-semibold">Min (₹)</label>
                        <input 
                          type="number" 
                          name="{{ filter.min_value.param_name }}" 
                          value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                          placeholder="0"
                          min="0"
                          class="w-full h-9 px-2.5 rounded-lg bg-surface-container-low border border-outline-variant/40 text-body-sm"
                        >
                      </div>
                      <span class="text-on-surface-variant mt-3">-</span>
                      <div class="flex-1">
                        <label class="text-[10px] text-on-surface-variant uppercase font-semibold">Max (₹)</label>
                        <input 
                          type="number" 
                          name="{{ filter.max_value.param_name }}" 
                          value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                          placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          min="0"
                          class="w-full h-9 px-2.5 rounded-lg bg-surface-container-low border border-outline-variant/40 text-body-sm"
                        >
                      </div>
                    </div>
                    <button type="submit" class="w-full h-8 rounded-lg bg-inverse-surface text-inverse-on-surface hover:bg-primary text-label-sm font-semibold transition-colors">
                      Apply Price
                    </button>
                  </div>
              {%- endcase -%}
            </div>
          {%- else -%}
            <!-- Fallback Mock Filter Categories if collection filters aren't enabled in Shopify Admin yet -->
            <div class="space-y-4 text-body-sm">
              <div>
                <h4 class="text-label-md font-bold uppercase text-on-surface mb-2">Category</h4>
                <div class="space-y-2">
                  <label class="flex items-center gap-2 text-on-surface"><input type="checkbox" checked class="rounded text-primary"> All Categories</label>
                  <label class="flex items-center gap-2 text-on-surface-variant"><input type="checkbox" class="rounded text-primary"> Smartphones (24)</label>
                  <label class="flex items-center gap-2 text-on-surface-variant"><input type="checkbox" class="rounded text-primary"> Audio Architecture (32)</label>
                  <label class="flex items-center gap-2 text-on-surface-variant"><input type="checkbox" class="rounded text-primary"> Computing &amp; Workstations (18)</label>
                  <label class="flex items-center gap-2 text-on-surface-variant"><input type="checkbox" class="rounded text-primary"> Wearables &amp; GPS (15)</label>
                </div>
              </div>
              <div class="pt-4 border-t border-outline-variant/20">
                <h4 class="text-label-md font-bold uppercase text-on-surface mb-2">Availability</h4>
                <div class="space-y-2">
                  <label class="flex items-center gap-2 text-on-surface"><input type="checkbox" checked class="rounded text-primary"> In Stock (Direct Hub)</label>
                  <label class="flex items-center gap-2 text-on-surface-variant"><input type="checkbox" class="rounded text-primary"> Pre-Order Next Drop</label>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </form>
      </aside>

      <!-- Right Product Listing Grid -->
      <div class="lg:col-span-9">
        {%- paginate collection.products by 12 -%}
          {%- if collection.products.size > 0 -%}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {%- for product in collection.products -%}
                {% render 'product-card', product: product %}
              {%- endfor -%}
            </div>

            {%- if paginate.pages > 1 -%}
              <div class="mt-12 flex justify-center items-center gap-2">
                {{ paginate | default_pagination: next: '→', previous: '←' }}
              </div>
            {%- endif -%}
          {%- else -%}
            <!-- Fallback Preview Cards so collection always renders stunning UI -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
