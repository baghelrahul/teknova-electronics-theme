{%- comment -%}
  NEXORA / TEKNOVA - Main Collection Section
  Fully dynamic backend filters: Price Range, Product Tags (Specs), Categories (Types), Vendors, and Availability
  Reactive client-side + server-side filtering engine with URL state preservation
{%- endcomment -%}

{%- liquid
  # Determine dynamic min and max price bounds from collection products
  assign collection_min_price = 0
  assign collection_max_price = 200000
  if collection.products.size > 0
    assign first_price = collection.products.first.price | divided_by: 100
    assign collection_min_price = first_price
    assign collection_max_price = first_price
    for prod in collection.products
      assign p_val = prod.price | divided_by: 100
      if p_val < collection_min_price
        assign collection_min_price = p_val
      endif
      if p_val > collection_max_price
        assign collection_max_price = p_val
      endif
    endfor
  endif
-%}

<section class="py-12 bg-surface" id="MainCollectionSection" data-section-id="{{ section.id }}">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <!-- Header Bar -->
    <div class="mb-8 pb-6 border-b border-outline-variant/30 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <nav class="flex items-center space-x-2 text-label-sm font-label-sm text-on-surface-variant mb-2">
          <a href="{{ routes.root_url }}" class="hover:text-primary transition-colors">Home</a>
          <span>/</span>
          <span class="text-on-surface font-semibold">{{ collection.title | default: 'Catalog' }}</span>
        </nav>
        <h1 class="text-3xl sm:text-headline-lg font-headline-lg font-bold text-on-surface">
          {{ collection.title }}
        </h1>
        {%- if collection.description != blank -%}
          <p class="text-body-md font-body-md text-on-surface-variant mt-2 max-w-2xl">
            {{ collection.description }}
          </p>
        {%- endif -%}
      </div>

      <!-- Sorting & Mobile Filter Toggle -->
      <div class="flex items-center gap-3">
        <!-- Mobile Filter Button -->
        <button 
          type="button" 
          class="lg:hidden flex items-center gap-2 px-4 py-2.5 rounded-xl bg-surface-container-lowest border border-outline-variant/40 text-label-md font-semibold text-on-surface shadow-sm active:scale-95 transition-all"
          onclick="document.getElementById('mobile-filter-drawer').classList.remove('translate-x-full'); document.getElementById('mobile-filter-backdrop').classList.remove('hidden');"
        >
          <span class="material-symbols-outlined text-[18px]">filter_list</span>
          <span>Filters</span>
          <span id="mobile-filter-count-badge" class="hidden px-1.5 py-0.2 rounded-full bg-primary text-on-primary text-[10px] font-bold"></span>
        </button>

        <!-- Sort By Dropdown -->
        <div class="relative">
          <select 
            id="SortBy" 
            name="sort_by" 
            class="h-10 pl-3 pr-8 rounded-xl bg-surface-container-lowest border border-outline-variant/40 text-label-md font-label-md text-on-surface focus:outline-none focus:border-primary cursor-pointer shadow-sm"
            onchange="nexoraFilterEngine.handleSort(this.value);"
          >
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            <option value="featured" {% if sort_by == 'manual' or sort_by == 'featured' %}selected{% endif %}>Featured Hardware</option>
            <option value="best-selling" {% if sort_by == 'best-selling' %}selected{% endif %}>Best Selling</option>
            <option value="price-ascending" {% if sort_by == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
            <option value="price-descending" {% if sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
            <option value="created-descending" {% if sort_by == 'created-descending' %}selected{% endif %}>Newest Releases</option>
          </select>
        </div>

        <span id="CollectionProductCountBadge" class="text-label-md font-label-md text-on-surface-variant bg-surface-container px-3 py-1.5 rounded-full shrink-0 font-semibold">
          <span id="visible-count">{{ collection.products_count | default: 6 }}</span> Products
        </span>
      </div>
    </div>

    <!-- Active Filter Chips Bar -->
    <div id="active-filters-bar" class="hidden flex-wrap items-center gap-2 mb-6 p-3 rounded-xl bg-surface-container-low/60 border border-outline-variant/30">
      <span class="text-label-sm font-bold text-on-surface-variant mr-1 flex items-center gap-1">
        <span class="material-symbols-outlined text-[15px] text-primary">filter_alt</span>
        Active Filters:
      </span>
      <div id="active-chips-container" class="flex flex-wrap items-center gap-2"></div>
      <button 
        type="button" 
        onclick="nexoraFilterEngine.clearAll();" 
        class="text-label-sm font-bold text-rose-500 hover:text-rose-600 hover:underline ml-2 transition-colors cursor-pointer"
      >
        Clear All
      </button>
    </div>

    <!-- Main Grid with Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Desktop Sidebar Filters -->
      <aside class="hidden lg:block lg:col-span-3 rounded-2xl bg-surface-container-lowest border border-outline-variant/40 p-6 sticky top-28 space-y-6 shadow-sm">
        <div class="flex items-center justify-between pb-4 border-b border-outline-variant/30">
          <h3 class="text-headline-sm font-bold text-on-surface text-[17px] flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px] text-primary">tune</span>
            <span>Filter Hardware</span>
          </h3>
          <button 
            type="button" 
            onclick="nexoraFilterEngine.clearAll();" 
            class="text-label-sm text-primary hover:underline font-semibold cursor-pointer"
          >
            Reset
          </button>
        </div>

        <form id="CollectionFiltersForm" class="space-y-6" onsubmit="event.preventDefault(); nexoraFilterEngine.applyPriceFilter();">
          <!-- 1. DYNAMIC PRICE FILTER -->
          <div class="pb-6 border-b border-outline-variant/20">
            <div class="flex items-center justify-between mb-3">
              <h4 class="text-label-md font-label-md font-bold uppercase text-on-surface flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px] text-primary">payments</span>
                <span>Price (₹)</span>
              </h4>
              <span id="price-range-indicator" class="text-[11px] font-mono font-semibold text-primary"></span>
            </div>

            <!-- Price Input Fields -->
            <div class="space-y-3">
              <div class="flex items-center gap-2">
                <div class="flex-1">
                  <label class="block text-[10px] text-on-surface-variant uppercase font-semibold mb-1">Min (₹)</label>
                  <input 
                    type="number" 
                    id="filter-price-min" 
                    name="filter.v.price.gte" 
                    placeholder="{{ collection_min_price }}"
                    min="0"
                    step="500"
                    class="w-full h-9 px-3 rounded-lg bg-surface-container-low border border-outline-variant/40 text-body-sm text-on-surface focus:outline-none focus:border-primary font-mono"
                    oninput="nexoraFilterEngine.onPriceInput();"
                  >
                </div>
                <span class="text-on-surface-variant font-bold mt-5">-</span>
                <div class="flex-1">
                  <label class="block text-[10px] text-on-surface-variant uppercase font-semibold mb-1">Max (₹)</label>
                  <input 
                    type="number" 
                    id="filter-price-max" 
                    name="filter.v.price.lte" 
                    placeholder="{{ collection_max_price }}"
                    min="0"
                    step="500"
                    class="w-full h-9 px-3 rounded-lg bg-surface-container-low border border-outline-variant/40 text-body-sm text-on-surface focus:outline-none focus:border-primary font-mono"
                    oninput="nexoraFilterEngine.onPriceInput();"
                  >
                </div>
              </div>

              <!-- Quick Price Bracket Presets -->
              <div class="pt-1 flex flex-wrap gap-1.5">
                <button type="button" onclick="nexoraFilterEngine.setPricePreset(0, 15000);" class="px-2 py-1 rounded-md text-[11px] bg-surface-container text-on-surface hover:bg-primary/20 hover:text-primary transition-all">
                  &lt; ₹15K
                </button>
                <button type="button" onclick="nexoraFilterEngine.setPricePreset(15000, 35000);" class="px-2 py-1 rounded-md text-[11px] bg-surface-container text-on-surface hover:bg-primary/20 hover:text-primary transition-all">
                  ₹15K - ₹35K
                </button>
                <button type="button" onclick="nexoraFilterEngine.setPricePreset(35000, 75000);" class="px-2 py-1 rounded-md text-[11px] bg-surface-container text-on-surface hover:bg-primary/20 hover:text-primary transition-all">
                  ₹35K - ₹75K
                </button>
                <button type="button" onclick="nexoraFilterEngine.setPricePreset(75000, 200000);" class="px-2 py-1 rounded-md text-[11px] bg-surface-container text-on-surface hover:bg-primary/20 hover:text-primary transition-all">
                  &gt; ₹75K
                </button>
              </div>

              <button 
                type="button" 
                onclick="nexoraFilterEngine.applyPriceFilter();" 
                class="w-full h-8 rounded-lg bg-inverse-surface text-inverse-on-surface hover:bg-primary text-label-sm font-semibold transition-colors flex items-center justify-center gap-1 shadow-sm"
              >
                <span>Apply Price</span>
              </button>
            </div>
          </div>

          <!-- 2. DYNAMIC TAGS FILTER (From backend collection.all_tags) -->
          {%- if collection.all_tags.size > 0 -%}
            <div class="pb-6 border-b border-outline-variant/20">
              <div class="flex items-center justify-between mb-3">
                <h4 class="text-label-md font-label-md font-bold uppercase text-on-surface flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-[16px] text-primary">sell</span>
                  <span>Tags & Specs</span>
                </h4>
                <span class="text-[11px] text-on-surface-variant font-mono">({{ collection.all_tags.size }})</span>
              </div>

              <div class="space-y-2 max-h-56 overflow-y-auto custom-scrollbar pr-1">
                {%- for tag in collection.all_tags -%}
                  {%- assign tag_lower = tag | downcase -%}
                  <label class="flex items-center justify-between text-body-sm text-on-surface cursor-pointer hover:text-primary group select-none">
                    <div class="flex items-center gap-2.5">
                      <input 
                        type="checkbox" 
                        value="{{ tag_lower }}"
                        data-filter-tag
                        class="rounded border-outline-variant text-primary focus:ring-primary w-4 h-4 cursor-pointer"
                        onchange="nexoraFilterEngine.onFilterChange();"
                      >
                      <span class="group-hover:text-primary transition-colors text-[13px] capitalize">{{ tag }}</span>
                    </div>
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <!-- 3. DYNAMIC CATEGORY / PRODUCT TYPE FILTER (From backend collection.all_types) -->
          {%- if collection.all_types.size > 0 -%}
            <div class="pb-6 border-b border-outline-variant/20">
              <div class="flex items-center justify-between mb-3">
                <h4 class="text-label-md font-label-md font-bold uppercase text-on-surface flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-[16px] text-primary">category</span>
                  <span>Category</span>
                </h4>
                <span class="text-[11px] text-on-surface-variant font-mono">({{ collection.all_types.size }})</span>
              </div>

              <div class="space-y-2 max-h-48 overflow-y-auto custom-scrollbar pr-1">
                {%- for type in collection.all_types -%}
                  {%- if type != blank -%}
                    {%- assign type_lower = type | downcase -%}
                    <label class="flex items-center justify-between text-body-sm text-on-surface cursor-pointer hover:text-primary group select-none">
                      <div class="flex items-center gap-2.5">
                        <input 
                          type="checkbox" 
                          value="{{ type_lower }}"
                          data-filter-type
                          class="rounded border-outline-variant text-primary focus:ring-primary w-4 h-4 cursor-pointer"
                          onchange="nexoraFilterEngine.onFilterChange();"
                        >
                        <span class="group-hover:text-primary transition-colors text-[13px]">{{ type }}</span>
                      </div>
                    </label>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <!-- 4. DYNAMIC BRAND / VENDOR FILTER (From backend collection.all_vendors) -->
          {%- if collection.all_vendors.size > 0 -%}
            <div class="pb-6 border-b border-outline-variant/20">
              <div class="flex items-center justify-between mb-3">
                <h4 class="text-label-md font-label-md font-bold uppercase text-on-surface flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-[16px] text-primary">verified</span>
                  <span>Brand</span>
                </h4>
                <span class="text-[11px] text-on-surface-variant font-mono">({{ collection.all_vendors.size }})</span>
              </div>

              <div class="space-y-2 max-h-40 overflow-y-auto custom-scrollbar pr-1">
                {%- for vendor in collection.all_vendors -%}
                  {%- if vendor != blank -%}
                    {%- assign vendor_lower = vendor | downcase -%}
                    <label class="flex items-center justify-between text-body-sm text-on-surface cursor-pointer hover:text-primary group select-none">
                      <div class="flex items-center gap-2.5">
                        <input 
                          type="checkbox" 
                          value="{{ vendor_lower }}"
                          data-filter-vendor
                          class="rounded border-outline-variant text-primary focus:ring-primary w-4 h-4 cursor-pointer"
                          onchange="nexoraFilterEngine.onFilterChange();"
                        >
                        <span class="group-hover:text-primary transition-colors text-[13px]">{{ vendor }}</span>
                      </div>
                    </label>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <!-- 5. AVAILABILITY FILTER -->
          <div class="pt-1">
            <h4 class="text-label-md font-label-md font-bold uppercase text-on-surface mb-3 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[16px] text-primary">inventory_2</span>
              <span>Availability</span>
            </h4>
            <div class="space-y-2">
              <label class="flex items-center gap-2.5 text-body-sm text-on-surface cursor-pointer select-none">
                <input 
                  type="checkbox" 
                  value="true" 
                  data-filter-available
                  class="rounded border-outline-variant text-primary focus:ring-primary w-4 h-4 cursor-pointer"
                  onchange="nexoraFilterEngine.onFilterChange();"
                >
                <span class="text-[13px]">In Stock Only</span>
              </label>
            </div>
          </div>
        </form>
      </aside>

      <!-- Right Product Listing Grid -->
      <div class="lg:col-span-9">
        {%- paginate collection.products by 48 -%}
          {%- if collection.products.size > 0 -%}
            <div id="CollectionProductGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 transition-opacity duration-200">
              {%- for product in collection.products -%}
                {% render 'product-card', product: product %}
              {%- endfor -%}
            </div>

            <!-- Empty State for Filters -->
            <div id="filter-empty-state" class="hidden text-center py-16 px-6 rounded-2xl bg-surface-container-lowest border border-outline-variant/40">
              <div class="w-16 h-16 rounded-full bg-surface-container flex items-center justify-center mx-auto mb-4 text-on-surface-variant">
                <span class="material-symbols-outlined text-[32px]">filter_alt_off</span>
              </div>
              <h3 class="text-headline-sm font-bold text-on-surface mb-2">No matching hardware found</h3>
              <p class="text-body-md text-on-surface-variant max-w-md mx-auto mb-6">
                Try widening your price range or unselecting some tags to view more products.
              </p>
              <button 
                type="button" 
                onclick="nexoraFilterEngine.clearAll();" 
                class="px-6 py-2.5 rounded-xl bg-primary text-on-primary font-bold text-label-md hover:opacity-90 transition-opacity"
              >
                Clear All Filters
              </button>
            </div>

            {%- if paginate.pages > 1 -%}
              <div class="mt-12 flex justify-center items-center gap-2">
                {{ paginate | default_pagination: next: '→', previous: '←' }}
              </div>
            {%- endif -%}
          {%- else -%}
            <!-- Fallback Mock Cards if store catalog is empty -->
            <div id="CollectionProductGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {% render 'product-card', 
                title: 'NEXORA Horizon Pro 5G',
                subtitle: 'Snapdragon 8 Gen 4 • 256GB',
                price: '₹79,999',
                compare_price: '₹89,999',
                badge: 'BESTSELLER',
                image_url: 'https://lh3.googleusercontent.com/aida-public/AB6AXuAHd2i7JFJU5gOjCxLAuDh9SxZq0GnvRtX-5Nq_0vBMBlAaGHqLElxih1xyE35e9woQAoRHapcUAj35nlm6XdPSP7G7gyE5wMbtaxSwaIQcZYP6jLwpbk4NKHgKTY9-gI8WNRMz1yc7ULZvXOr4ye7dlV7iG2JHpxhTfiy9_YSJHsBV9dE5R-nGMf-qtx7YQAU6wzn-C-z6o4g08sCzZViJeiYfGRNMFaz4Yp2M-CU'
              %}
              {% render 'product-card', 
                title: 'AuraWave Max ANC',
                subtitle: 'Spatial Audio • 65h Battery',
                price: '₹24,999',
                compare_price: '₹29,999',
                badge: 'NEW ARRIVAL',
                image_url: 'https://lh3.googleusercontent.com/aida-public/AB6AXuBHb7Bl2Z5IHFL3OkzOWQX4iUBjLq_3P6nGxVOOmkw31wMkUJzhn4NdB8R5xOj2CyeYyKQAfKGsCEg-tzbSwz197BIj0WDA3O84BtW71kG_W5DIg12WD4Mf1MAiM9E3OoDj66l9P3rpe-3viO6NQoXHesgg4m3FaZ_OFjMeggJ0m7K7lL_EjpsNLhpMRE60n9_lMNZ8BRpTDhmTlbIXy2vKAmvkQfYBeffWYni7QcA'
              %}
              {% render 'product-card', 
                title: 'Chronos Ultra Gen 3',
                subtitle: 'Sapphire • ECG & Dual-GPS',
                price: '₹18,499',
                compare_price: '₹22,999',
                badge: '15% OFF',
                image_url: 'https://lh3.googleusercontent.com/aida-public/AB6AXuCfSdKvtWdH7s8crJfrzA0TQi7kZWEraNdF8nBpKWbe2GjnRk-YF1Os4MSaMLdB5Mgmig8PUmEZ1OcKamRaVNtl6wqYTiO3n5K_7dcsshVavo7-1s6LaIaQNXwnFOwMNqXjwfncrLu_optMMxqDHNey966SewbyBmjQaFSztVwZejoL2bdrn9hgUBYu2CwppjobbQwKgbYQtsGb2zr4J-Ma2q4BUeE_TwNIdIYbMPQ'
              %}
              {% render 'product-card', 
                title: 'Vanguard AeroBook 16',
                subtitle: '3.2K Mini-LED • 32GB RAM',
                price: '₹1,24,999',
                compare_price: '₹1,39,999',
                badge: 'CREATOR PICK',
                image_url: 'https://lh3.googleusercontent.com/aida-public/AB6AXuBBRjRtulXjIJD4c4cnXAnBZ5-cUYeOwNXD5iTHpFbyYgF1dQWj0OCz08YJiV1W_NOECunsGCQy7BS_h7lX4QBrG4SUL7aTTTISgeIDjL-hTcYB7ZE8ET1ginuCc5dg0EE6a-R3Ly1KOKnHNgcuPfTMyDYVlw8E3_zVl4ni7wMqCn8bbq5_P6_F41wltVfFRNKTWdmsUUs_DY6yMd01jGnTOxpzUwyzFK6f6zC7-70'
              %}
              {% render 'product-card', 
                title: 'PulseBuds Pro 2 Spatial',
                subtitle: 'Planar Drivers • Qi Wireless',
                price: '₹9,999',
                compare_price: '₹12,999',
                badge: 'TRENDING',
                image_url: 'https://lh3.googleusercontent.com/aida-public/AB6AXuA-IRl4Zh00GtRavPgSOTQZd6MjTIf8LmqOxb96GdExHlTavKBfe659frc7Cord7QOZ9CIhqsBjJRwu2BkJ1vOoo2GWGtO_J044FoCIgtSyFbsRCRxZsF9jgbf9LH2sTkbVLRTAV5LqF4GhuDhCDyecV0btbS7EyNyFSXfGM1n_bLlfpXn5y6fP92nQM4TvrBL51DiPHNm3WS_TAwSAj_HY_a7pmNHUcI4Ydo8YO7s'
              %}
              {% render 'product-card', 
                title: 'VividView 34" Curved OLED',
                subtitle: '240Hz 0.03ms • 99% DCI-P3',
                price: '₹64,990',
