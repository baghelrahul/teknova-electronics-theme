              %}
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
  </div>
</section>

<!-- Mobile Filter Drawer Backdrop -->
<div id="mobile-filter-backdrop" class="fixed inset-0 bg-black/50 z-50 hidden transition-opacity duration-300" onclick="this.classList.add('hidden'); document.getElementById('mobile-filter-drawer').classList.add('translate-x-full');"></div>

<!-- Mobile Filter Drawer -->
<div id="mobile-filter-drawer" class="fixed top-0 right-0 w-80 max-w-[85vw] h-full bg-surface z-50 transform translate-x-full transition-transform duration-300 shadow-2xl flex flex-col justify-between p-6">
  <div>
    <div class="flex items-center justify-between pb-4 border-b border-outline-variant/30 mb-6">
      <h3 class="text-headline-sm font-bold text-on-surface">Filters</h3>
      <button type="button" class="p-2 text-on-surface-variant hover:text-primary" onclick="document.getElementById('mobile-filter-drawer').classList.add('translate-x-full'); document.getElementById('mobile-filter-backdrop').classList.add('hidden');">
        <span class="material-symbols-outlined text-[22px]">close</span>
      </button>
    </div>

    <div class="space-y-6 overflow-y-auto max-h-[75vh]">
      {%- for filter in collection.filters -%}
        <div>
          <h4 class="text-label-md font-bold uppercase text-on-surface mb-2">{{ filter.label }}</h4>
          <div class="space-y-2">
            {%- for value in filter.values -%}
              <label class="flex items-center gap-2 text-body-sm text-on-surface">
                <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} class="rounded text-primary">
                <span>{{ value.label }} ({{ value.count }})</span>
              </label>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="pt-4 border-t border-outline-variant/30">
    <button type="button" class="w-full h-11 rounded-xl bg-primary text-on-primary font-bold text-label-md" onclick="document.getElementById('CollectionFiltersForm').submit();">
      Apply Filters
    </button>
  </div>
</div>

{% schema %}
{
  "name": "Collection Grid & Filters",
  "settings": []
}
{% endschema %}
