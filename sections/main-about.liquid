{%- comment -%}
  NEXORA / TEKNOVA - Main About Page Section
  Editorial brand story, engineering pillars, architecture timeline, and lab showcase
{%- endcomment -%}

<section class="py-16 lg:py-24 bg-surface">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-label-sm font-label-sm text-on-surface-variant mb-8">
      <a href="{{ routes.root_url }}" class="hover:text-primary">Home</a>
      <span>/</span>
      <span class="text-on-surface font-semibold">About NEXORA</span>
    </nav>

    <!-- Hero Intro -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-label-sm font-bold mb-4">
        <span>ARCHITECTURAL HARDWARE LAB</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-display font-display font-bold tracking-tight text-on-surface mb-6">
        Architecting the Future of <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary">
          Personal Technology.
        </span>
      </h1>
      <p class="text-body-lg font-body-lg text-on-surface-variant leading-relaxed">
        Founded on the premise that everyday electronics should not only be blindingly fast, but tactilely sublime, endlessly durable, and acoustically pure. We eliminate bloat and calibrate every micro-millimeter for high-output creators, engineers, and audio purists.
      </p>
    </div>

    <!-- Visual Banner / Studio Showcase -->
    <div class="w-full aspect-[21/9] rounded-3xl bg-surface-container-lowest border border-outline-variant/40 overflow-hidden mb-20 shadow-xl relative">
      <img 
        src="https://lh3.googleusercontent.com/aida-public/AB6AXuCkxZpAHxSzfcnq16zYHgorBZZoVbm42YVyrYwclhvE15Nvda0BKKBXeipwci_yZBRkQkLEspMJOcNiDEqDRmAKtoxgABFMSnEHsDW1st0MHAri8WCfecL6llqDx_uWlhVKC2Xh_Mnfpz52PqKkTuraZA5xjN1CpNqxJ3pNF0V4eiLHL28QWmVuun_ONFHo9nVMl-P1rgo9Te2QYI7NXX4YIuBfHpVAGiNrBNae9ls" 
        alt="NEXORA Engineering Studio" 
        class="w-full h-full object-cover"
      >
      <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface/80 via-transparent to-transparent flex items-end p-8 lg:p-12">
        <p class="text-inverse-on-surface text-label-md font-semibold tracking-wide">
          Bengaluru Hardware Prototyping &amp; Acoustic Testing Laboratory
        </p>
      </div>
    </div>

    <!-- 4 Core Pillars -->
    <div class="mb-20">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-label-md font-label-md uppercase tracking-wider text-primary font-semibold">Core Philosophies</span>
        <h2 class="text-headline-lg font-headline-lg font-bold text-on-surface mt-1">Our Engineering Standards</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-8 rounded-3xl bg-surface-container-lowest border border-outline-variant/40 hover:border-primary/50 transition-all shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-6">
            <span class="material-symbols-outlined text-[26px]">spatial_audio_off</span>
          </div>
          <h3 class="text-headline-sm font-bold text-on-surface mb-3">Planar Acoustic Fidelity</h3>
          <p class="text-body-md text-on-surface-variant leading-relaxed">
            Sub-millimeter planar magnetic transducers and CNC-carved beryllium resonance chambers delivering zero harmonic distortion.
          </p>
        </div>

        <div class="p-8 rounded-3xl bg-surface-container-lowest border border-outline-variant/40 hover:border-primary/50 transition-all shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-secondary/10 text-secondary flex items-center justify-center mb-6">
            <span class="material-symbols-outlined text-[26px]">precision_manufacturing</span>
          </div>
          <h3 class="text-headline-sm font-bold text-on-surface mb-3">Titanium &amp; Ceramic</h3>
          <p class="text-body-md text-on-surface-variant leading-relaxed">
            Aerospace grade 5 titanium chassis, sapphire crystal dials, and fluororubber loop bands designed to outlive trends.
          </p>
        </div>

        <div class="p-8 rounded-3xl bg-surface-container-lowest border border-outline-variant/40 hover:border-primary/50 transition-all shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-6">
            <span class="material-symbols-outlined text-[26px]">verified</span>
          </div>
          <h3 class="text-headline-sm font-bold text-on-surface mb-3">Direct Authentication</h3>
          <p class="text-body-md text-on-surface-variant leading-relaxed">
            Authorized Tier-1 distribution contracts directly with industry leaders ensuring digital serial authentication on delivery.
          </p>
        </div>

        <div class="p-8 rounded-3xl bg-surface-container-lowest border border-outline-variant/40 hover:border-primary/50 transition-all shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-secondary/10 text-secondary flex items-center justify-center mb-6">
            <span class="material-symbols-outlined text-[26px]">eco</span>
          </div>
          <h3 class="text-headline-sm font-bold text-on-surface mb-3">Circular Lifecycle</h3>
          <p class="text-body-md text-on-surface-variant leading-relaxed">
            100% recycled aluminum alloys, zero single-use plastics in packaging, and trade-in hardware recycling programs.
          </p>
        </div>
      </div>
    </div>

    <!-- Metrics Bar -->
    <div class="p-8 lg:p-12 rounded-3xl bg-inverse-surface text-inverse-on-surface grid grid-cols-2 md:grid-cols-4 gap-8 text-center shadow-xl">
      <div>
        <span class="block text-4xl sm:text-headline-lg font-display font-bold text-inverse-primary mb-1">42,800+</span>
        <span class="text-label-md font-label-md text-inverse-on-surface/70">Verified Device Owners</span>
      </div>
      <div>
        <span class="block text-4xl sm:text-headline-lg font-display font-bold text-inverse-primary mb-1">100+</span>
        <span class="text-label-md font-label-md text-inverse-on-surface/70">Metro Express Hubs</span>
      </div>
      <div>
        <span class="block text-4xl sm:text-headline-lg font-display font-bold text-inverse-primary mb-1">99.8%</span>
        <span class="text-label-md font-label-md text-inverse-on-surface/70">Hardware Satisfaction</span>
      </div>
      <div>
        <span class="block text-4xl sm:text-headline-lg font-display font-bold text-inverse-primary mb-1">&lt; 6 Hrs</span>
        <span class="text-label-md font-label-md text-inverse-on-surface/70">Average Dispatch Speed</span>
      </div>
    </div>
  </div>
</section>

