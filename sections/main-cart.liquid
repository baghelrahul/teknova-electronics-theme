{%- comment -%}
  NEXORA / TEKNOVA - Main Cart Section
  High-conversion shopping cart layout with item breakdown and order summary
{%- endcomment -%}

<section class="py-12 bg-surface">
  <div class="max-w-7xl mx-auto px-6">
    <h1 class="text-3xl sm:text-headline-lg font-headline-lg font-bold text-on-surface mb-8">
      Your Cart ({{ cart.item_count }})
    </h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <!-- Cart Items List -->
        <div class="lg:col-span-8 space-y-4">
          <div class="rounded-2xl bg-surface-container-lowest border border-outline-variant/40 overflow-hidden p-6 divide-y divide-outline-variant/30">
            {%- for item in cart.items -%}
              <div class="py-6 first:pt-0 last:pb-0 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
                <div class="flex items-center gap-4">
                  <div class="w-20 h-20 rounded-xl bg-surface-container-low border border-outline-variant/30 overflow-hidden shrink-0">
                    {%- if item.image != blank -%}
                      <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" class="w-full h-full object-contain p-2">
                    {%- endif -%}
                  </div>
                  <div>
                    <h3 class="text-headline-sm font-semibold text-on-surface line-clamp-1">
                      <a href="{{ item.url }}" class="hover:text-primary">{{ item.product.title }}</a>
                    </h3>
                    {%- unless item.product.has_only_default_variant -%}
                      <p class="text-body-sm text-on-surface-variant">{{ item.variant.title }}</p>
                    {%- endunless -%}
                    <span class="text-body-md font-bold text-on-surface sm:hidden block mt-1">
                      {{ item.final_price | money }}
                    </span>
                  </div>
                </div>

                <div class="flex items-center justify-between w-full sm:w-auto sm:space-x-8">
                  <!-- Quantity -->
                  <div class="flex items-center border border-outline-variant/60 rounded-lg bg-surface-container-lowest h-9">
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="w-8 h-full flex items-center justify-center text-on-surface-variant hover:text-on-surface">-</a>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="w-10 h-full text-center border-none bg-transparent font-semibold text-on-surface focus:ring-0 text-sm">
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="w-8 h-full flex items-center justify-center text-on-surface-variant hover:text-on-surface">+</a>
                  </div>

                  <span class="text-headline-sm font-bold text-on-surface hidden sm:block">
                    {{ item.final_line_price | money }}
                  </span>

                  <!-- Remove -->
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="text-on-surface-variant hover:text-rose-600 transition-colors" title="Remove">
                    <span class="material-symbols-outlined text-[20px]">delete</span>
                  </a>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        <!-- Order Summary -->
        <div class="lg:col-span-4">
          <div class="p-6 rounded-2xl bg-surface-container-lowest border border-outline-variant/40 space-y-4">
            <h2 class="text-headline-sm font-bold text-on-surface">Order Summary</h2>

            <div class="flex items-center justify-between text-body-md text-on-surface-variant">
              <span>Subtotal</span>
              <span class="font-bold text-on-surface">{{ cart.total_price | money }}</span>
            </div>

            <div class="flex items-center justify-between text-body-md text-on-surface-variant">
              <span>Shipping</span>
              <span class="text-emerald-600 font-semibold">FREE (Express Insured)</span>
            </div>

            <div class="pt-4 border-t border-outline-variant/30 flex items-center justify-between text-headline-sm font-bold text-on-surface">
              <span>Estimated Total</span>
              <span class="text-primary">{{ cart.total_price | money }}</span>
            </div>

            <p class="text-body-sm text-on-surface-variant/70 text-xs">
              Taxes calculated at checkout. Powered by 256-bit encrypted secure bank checkout.
            </p>

            <button type="submit" name="checkout" class="w-full h-12 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md font-bold transition-all shadow-md flex items-center justify-center gap-2">
              <span class="material-symbols-outlined text-[18px]">lock</span>
              <span>Proceed to Checkout</span>
            </button>

            <a href="{{ routes.all_products_collection_url }}" class="block text-center text-body-sm font-semibold text-primary hover:underline pt-2">
              Continue Shopping →
            </a>
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="text-center py-20 bg-surface-container-lowest rounded-2xl border border-outline-variant/30 max-w-xl mx-auto p-8">
        <span class="material-symbols-outlined text-[56px] text-on-surface-variant/40 mb-4">shopping_bag</span>
        <h2 class="text-headline-sm font-bold text-on-surface mb-2">Your Cart is Currently Empty</h2>
        <p class="text-body-md text-on-surface-variant mb-6">Discover the 2026 fleet of precision electronics, audio, and wearables.</p>
        <a href="{{ routes.all_products_collection_url }}" class="inline-flex px-8 py-3 rounded-lg bg-primary text-on-primary font-label-md text-label-md font-bold shadow-md hover:bg-primary-container transition-all">
          Explore Flagship Fleet
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
