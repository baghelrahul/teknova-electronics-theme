{%- comment -%}
  NEXORA / TEKNOVA - Main Cart Section
  Shopping cart layout with live progress bar, item breakdown, and recommended accessories
{%- endcomment -%}

<section class="py-12 bg-surface">
  <div class="max-w-7xl mx-auto px-6">
    <div class="mb-8 pb-4 border-b border-outline-variant/30 flex items-center justify-between">
      <h1 class="text-3xl sm:text-headline-lg font-headline-lg font-bold text-on-surface">
        Shopping Cart (<span data-cart-count>{{ cart.item_count }}</span>)
      </h1>
      <a href="{{ routes.all_products_collection_url }}" class="text-label-md font-bold text-primary hover:underline hidden sm:inline-block">
        &larr; Continue Exploring Hardware
      </a>
    </div>

    {%- if cart.item_count > 0 -%}
      <!-- Free Shipping Goal Progress Bar -->
      <div class="mb-8 p-4 rounded-2xl bg-surface-container-lowest border border-outline-variant/40 shadow-sm max-w-2xl">
        <div class="flex items-center justify-between text-body-sm mb-2 font-medium">
          <span class="flex items-center gap-1.5 text-on-surface">
            <span class="material-symbols-outlined text-[18px] text-emerald-500">local_shipping</span>
            <span>Free Express Delivery:</span>
          </span>
          <span class="font-bold text-emerald-600">UNLOCKED (Orders &gt; ₹999)</span>
        </div>
        <div class="w-full h-2 rounded-full bg-surface-container-low overflow-hidden">
          <div class="h-full bg-gradient-to-r from-emerald-500 to-secondary rounded-full" style="width: 100%;"></div>
        </div>
      </div>

      <form action="{{ routes.cart_url }}" method="post" class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <!-- Cart Items List -->
        <div class="lg:col-span-8 space-y-4">
          <div class="rounded-3xl bg-surface-container-lowest border border-outline-variant/40 overflow-hidden p-6 divide-y divide-outline-variant/30 shadow-sm">
            {%- for item in cart.items -%}
              <div class="py-6 first:pt-0 last:pb-0 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
                <div class="flex items-center gap-4">
                  <div class="w-20 h-20 rounded-2xl bg-surface-container-low border border-outline-variant/30 overflow-hidden shrink-0">
                    {%- if item.image != blank -%}
                      <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" class="w-full h-full object-contain p-2">
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
                    {%- endif -%}
                  </div>
                  <div>
                    <h3 class="text-headline-sm font-semibold text-on-surface line-clamp-1">
                      <a href="{{ item.url }}" class="hover:text-primary transition-colors">{{ item.product.title }}</a>
                    </h3>
                    {%- unless item.product.has_only_default_variant -%}
                      <p class="text-body-sm text-on-surface-variant">{{ item.variant.title }}</p>
                    {%- endunless -%}
                    <span class="text-body-md font-bold text-on-surface sm:hidden block mt-1">
                      {{ item.final_price | money }}
                    </span>
                  </div>
                </div>

                <div class="flex items-center justify-between w-full sm:w-auto sm:space-x-8">
                  <!-- Quantity -->
                  <div class="flex items-center border border-outline-variant/60 rounded-xl bg-surface-container-lowest h-10 px-1">
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="w-8 h-full flex items-center justify-center text-on-surface-variant hover:text-on-surface text-lg font-bold">-</a>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="w-10 h-full text-center border-none bg-transparent font-semibold text-on-surface focus:ring-0 text-sm">
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="w-8 h-full flex items-center justify-center text-on-surface-variant hover:text-on-surface text-lg font-bold">+</a>
                  </div>

                  <span class="text-headline-sm font-bold text-on-surface hidden sm:block">
                    {{ item.final_line_price | money }}
                  </span>

                  <!-- Remove -->
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="text-on-surface-variant hover:text-rose-500 transition-colors" title="Remove">
                    <span class="material-symbols-outlined text-[22px]">delete</span>
                  </a>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        <!-- Order Summary -->
        <div class="lg:col-span-4">
          <div class="p-8 rounded-3xl bg-surface-container-lowest border border-outline-variant/40 space-y-5 shadow-xl sticky top-28">
            <h2 class="text-headline-sm font-bold text-on-surface">Order Summary</h2>

            <div class="space-y-3 pb-4 border-b border-outline-variant/30 text-body-md">
              <div class="flex items-center justify-between text-on-surface-variant">
                <span>Subtotal</span>
                <span class="font-bold text-on-surface">{{ cart.total_price | money }}</span>
              </div>
              <div class="flex items-center justify-between text-on-surface-variant">
                <span>Express Shipping</span>
                <span class="text-emerald-600 font-bold">FREE (Priority Insured)</span>
              </div>
              <div class="flex items-center justify-between text-on-surface-variant">
                <span>Transit Insurance</span>
                <span class="text-primary font-bold">Complimentary</span>
              </div>
            </div>

            <div class="flex items-center justify-between text-headline-sm font-bold text-on-surface">
              <span>Estimated Total</span>
              <span class="text-primary text-2xl font-display">{{ cart.total_price | money }}</span>
            </div>

            <p class="text-body-sm text-on-surface-variant/70 text-xs leading-relaxed">
              Taxes calculated at checkout. Backed by 256-bit bank encryption and instant digital GST invoice.
            </p>

            <button type="submit" name="checkout" class="w-full h-12 rounded-xl bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md font-bold transition-all shadow-md flex items-center justify-center gap-2">
              <span class="material-symbols-outlined text-[18px]">lock</span>
              <span>Proceed to Checkout</span>
            </button>

            <div class="pt-4 border-t border-outline-variant/20 space-y-2 text-label-sm text-on-surface-variant">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[16px] text-emerald-500">verified</span>
                <span>100% Genuine Direct Authenticated Devices</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[16px] text-secondary">sync</span>
                <span>7-Day Doorstep Replacement Guarantee</span>
              </div>
            </div>
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="text-center py-20 bg-surface-container-lowest rounded-3xl border border-outline-variant/30 max-w-xl mx-auto p-8 shadow-sm">
        <div class="w-16 h-16 rounded-full bg-surface-container-low text-primary flex items-center justify-center mx-auto mb-4">
          <span class="material-symbols-outlined text-[36px]">shopping_bag</span>
        </div>
        <h2 class="text-headline-sm font-bold text-on-surface mb-2">Your Cart is Currently Empty</h2>
        <p class="text-body-md text-on-surface-variant mb-6">Discover the 2026 fleet of precision electronics, audio, and workstations.</p>
        <a href="{{ routes.all_products_collection_url }}" class="inline-flex px-8 py-3 rounded-xl bg-primary text-on-primary font-label-md text-label-md font-bold shadow-md hover:bg-primary-container transition-all">
          Explore Flagship Fleet
        </a>
      </div>
    {%- endif -%}

    <!-- Recommended Accessories Row -->
    <div class="mt-20 pt-12 border-t border-outline-variant/30">
      <div class="flex items-end justify-between mb-8">
        <div>
          <span class="text-label-md font-label-md uppercase tracking-wider text-primary font-semibold">Essential Accessories</span>
          <h3 class="text-headline-md font-headline-md font-bold text-on-surface mt-1">Frequently Paired with Your Setup</h3>
        </div>
        <a href="{{ routes.all_products_collection_url }}" class="text-label-md font-bold text-primary hover:underline">
          View All Hardware &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
