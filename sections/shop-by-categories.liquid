{%- comment -%}
  NEXORA / TEKNOVA - Section 4: Shop By Categories
  Engineered categories grid with image zoom and model count pill
{%- endcomment -%}

<section class="py-20 bg-surface" id="categories">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <span class="text-label-md font-label-md uppercase tracking-wider text-primary font-semibold">
          {{ section.settings.eyebrow | default: 'Classification' }}
        </span>
        <h2 class="text-headline-lg font-headline-lg text-on-surface mt-1">
          {{ section.settings.heading | default: 'Engineered Categories' }}
        </h2>
        <p class="text-body-md font-body-md text-on-surface-variant mt-1">
          {{ section.settings.subheading | default: 'Explore hardware tailored for creators, engineers, and audiophiles.' }}
        </p>
      </div>

      {%- if section.settings.view_all_text != blank -%}
        <a class="mt-4 md:mt-0 text-label-md font-label-md font-semibold text-primary hover:underline flex items-center gap-1" href="{{ section.settings.view_all_link | default: routes.collections_url }}">
          <span>{{ section.settings.view_all_text }}</span>
          <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        </a>
      {%- endif -%}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign cat_collection = block.settings.collection
            assign cat_title = block.settings.title
            if cat_title == blank and cat_collection != blank
              assign cat_title = cat_collection.title
            endif

            assign cat_link = block.settings.link
            if cat_link == blank and cat_collection != blank
              assign cat_link = cat_collection.url
            endif
          -%}
          <a class="group block rounded-2xl bg-surface-container-lowest border border-outline-variant/40 p-6 hover:border-primary/50 transition-all duration-300 hover:shadow-lg" href="{{ cat_link | default: '#' }}" {{ block.shopify_attributes }}>
            <div class="aspect-[4/3] rounded-xl bg-surface-container-low overflow-hidden mb-5">
              {%- if block.settings.image != blank -%}
                <img 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  src="{{ block.settings.image | image_url: width: 800 }}" 
                  alt="{{ cat_title | escape }}"
                  loading="lazy"
                />
              {%- elsif block.settings.fallback_image_url != blank -%}
                <img 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  src="{{ block.settings.fallback_image_url }}" 
                  alt="{{ cat_title | escape }}"
                  loading="lazy"
                />
              {%- elsif cat_collection.featured_image != blank -%}
                <img 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  src="{{ cat_collection.featured_image | image_url: width: 800 }}" 
                  alt="{{ cat_title | escape }}"
                  loading="lazy"
                />
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
              {%- endif -%}
            </div>
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-headline-sm font-headline-sm text-on-surface group-hover:text-primary transition-colors">
                  {{ cat_title | default: 'Category' }}
                </h3>
                <p class="text-body-sm font-body-sm text-on-surface-variant">
                  {{ block.settings.subtitle }}
                </p>
              </div>
              {%- if block.settings.count_badge != blank -%}
                <span class="px-2.5 py-1 rounded-full bg-surface-container text-label-sm font-label-sm text-on-surface-variant font-medium shrink-0 ml-2">
                  {{ block.settings.count_badge }}
                </span>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

