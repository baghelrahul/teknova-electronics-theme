            "author_name": "Arjun Kapoor",
            "product_purchased": "Horizon Pro 5G"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "badge": "Verified Buyer",
            "review_text": "AuraWave Max ANC completely silences metro commutes and open office chatter. Planar drivers deliver separation on acoustic tracks that rival my ₹80k desktop studio monitors.",
            "initials": "RM",
            "avatar_bg": "bg-secondary/10 text-secondary",
            "author_name": "Rohan Mehta",
            "product_purchased": "AuraWave Max ANC"
          }
        },
        {
