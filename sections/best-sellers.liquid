{%- comment -%}
  NEXORA / TEKNOVA - Section 7: Best Sellers ('Customer Favorites')
  4-column grid with urgency badges, category indicators, and quick buy
{%- endcomment -%}

<section class="py-20 bg-surface-container-lowest">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <span class="text-label-md font-label-md uppercase tracking-wider text-primary font-semibold">
          {{ section.settings.eyebrow | default: 'Enduring Reliability' }}
        </span>
        <h2 class="text-headline-lg font-headline-lg text-on-surface mt-1">
          {{ section.settings.heading | default: 'Customer Favorites' }}
        </h2>
        <p class="text-body-md font-body-md text-on-surface-variant mt-1">
          {{ section.settings.subheading | default: 'The gear our community relies on every single day for professional output.' }}
        </p>
      </div>

      {%- if section.settings.comparison_button_text != blank -%}
        <button type="button" class="mt-4 md:mt-0 px-4 py-2 rounded-lg border border-outline-variant/60 text-label-md font-label-md text-on-surface hover:border-primary flex items-center gap-2 transition-colors">
          <span class="material-symbols-outlined text-[18px]">tune</span>
          <span>{{ section.settings.comparison_button_text }}</span>
        </button>
      {%- endif -%}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
        {%- for product in section.settings.collection.products limit: 4 -%}
          <div class="rounded-2xl border border-outline-variant/40 p-5 bg-surface-container-lowest hover:border-primary/50 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="aspect-square rounded-xl bg-surface-container-low overflow-hidden mb-4 relative">
                {%- if product.compare_at_price > product.price -%}
                  <span class="absolute top-2 left-2 px-2 py-0.5 rounded-full bg-amber-500 text-white text-[10px] font-bold">Top Pick</span>
                {%- endif -%}
                <img class="w-full h-full object-cover" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy"/>
              </div>
              <span class="text-label-sm font-label-sm text-primary uppercase font-bold tracking-wider">{{ product.type | default: 'Hardware' }}</span>
              <h3 class="text-headline-sm font-headline-sm text-on-surface mt-1 line-clamp-1"><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <p class="text-body-sm font-body-sm text-on-surface-variant mt-1 line-clamp-1">{{ product.description | strip_html | truncate: 50 }}</p>
            </div>
            <div class="flex items-center justify-between mt-4 pt-3 border-t border-outline-variant/30">
              <span class="text-headline-sm font-headline-sm font-bold text-on-surface">{{ product.price | money }}</span>
              {% form 'product', product %}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button type="submit" class="h-9 px-3.5 rounded-lg bg-inverse-surface text-inverse-on-surface hover:bg-primary transition-colors text-label-md font-label-md font-semibold">
                  Add to Cart
                </button>
              {% endform %}
            </div>
          </div>
        {%- endfor -%}
      {%- elsif section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="rounded-2xl border border-outline-variant/40 p-5 bg-surface-container-lowest hover:border-primary/50 transition-all duration-300 flex flex-col justify-between" {{ block.shopify_attributes }}>
            <div>
              <div class="aspect-square rounded-xl bg-surface-container-low overflow-hidden mb-4 relative">
                {%- if block.settings.badge != blank -%}
                  <span class="absolute top-2 left-2 px-2 py-0.5 rounded-full {{ block.settings.badge_color | default: 'bg-amber-500 text-white' }} text-[10px] font-bold">
                    {{ block.settings.badge }}
                  </span>
                {%- endif -%}
                <img 
                  class="w-full h-full object-cover" 
                  src="{{ block.settings.image_url }}" 
                  alt="{{ block.settings.title | escape }}" 
                  loading="lazy"
                />
              </div>
              <span class="text-label-sm font-label-sm {{ block.settings.category_color | default: 'text-primary' }} uppercase font-bold tracking-wider">
                {{ block.settings.category }}
              </span>
              <h3 class="text-headline-sm font-headline-sm text-on-surface mt-1 line-clamp-1">
                <a href="{{ block.settings.link | default: '#' }}">{{ block.settings.title }}</a>
              </h3>
              <p class="text-body-sm font-body-sm text-on-surface-variant mt-1 line-clamp-1">
                {{ block.settings.description }}
              </p>
            </div>
            <div class="flex items-center justify-between mt-4 pt-3 border-t border-outline-variant/30">
              <span class="text-headline-sm font-headline-sm font-bold text-on-surface">{{ block.settings.price }}</span>
              <button type="button" class="h-9 px-3.5 rounded-lg bg-inverse-surface text-inverse-on-surface hover:bg-primary transition-colors text-label-md font-label-md font-semibold">
                Add to Cart
              </button>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

