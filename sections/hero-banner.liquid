      "label": "Description",
      "default": "Discover next-generation technology designed to make everyday life smarter, faster, and remarkably seamless. Calibrated for purists and creators."
    },
    {
      "type": "header",
      "content": "Call to Actions"
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA Label",
      "default": "Shop Now — Explore 2026 Fleet"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA Link"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Label",
      "default": "Explore Collections"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA Link"
    },
    {
      "type": "header",
      "content": "Hero Showcase Media & Badges"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "spec_1",
      "label": "Spec Pill 1 (Top-Left)",
      "default": "ANC 45dB Planar"
    },
    {
      "type": "text",
      "id": "spec_2",
      "label": "Spec Pill 2 (Bottom-Left)",
      "default": "M4 Architecture"
    },
    {
      "type": "text",
      "id": "spec_3",
      "label": "Spec Pill 3 (Right)",
      "default": "120Hz LTPO ProMotion"
    },
    {
      "type": "header",
      "content": "Trust Highlights"
    },
    {
      "type": "text",
      "id": "metric_1_val",
      "label": "Metric 1 Value",
      "default": "4.9 / 5"
    },
    {
      "type": "text",
      "id": "metric_1_label",
      "label": "Metric 1 Label",
      "default": "42k+ Verified Owners"
    },
    {
      "type": "text",
      "id": "metric_2_val",
      "label": "Metric 2 Value",
      "default": "Next-Day"
    },
    {
      "type": "text",
      "id": "metric_2_label",
      "label": "Metric 2 Label",
      "default": "Over 100+ Metro Hubs"
    },
    {
      "type": "text",
      "id": "metric_3_val",
      "label": "Metric 3 Value",
      "default": "100% Genuine"
    },
    {
      "type": "text",
      "id": "metric_3_label",
      "label": "Metric 3 Label",
      "default": "Direct Authorised Channel"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
