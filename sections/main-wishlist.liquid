      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    renderWishlistPage();
    document.addEventListener('nexora:wishlist:updated', renderWishlistPage);

    const clearBtn = document.getElementById('clear-wishlist-btn');
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (confirm('Clear all saved items from your wishlist?')) {
          localStorage.removeItem('nexora_wishlist_items');
          renderWishlistPage();
          if (window.Nexora && typeof window.Nexora.updateWishlistUI === 'function') {
            window.Nexora.updateWishlistUI();
          }
          document.querySelectorAll('[data-wishlist-count]').forEach((el) => {
            el.textContent = '0';
            el.style.setProperty('display', 'none', 'important');
            el.classList.add('hidden');
          });
        }
      });
    }
  });

  function renderWishlistPage() {
    const grid = document.getElementById('wishlist-grid');
    const emptyState = document.getElementById('wishlist-empty-state');
    const counter = document.getElementById('wishlist-page-counter');
    const clearBtn = document.getElementById('clear-wishlist-btn');

    if (!grid || !emptyState) return;

    let items = [];
    try {
      items = JSON.parse(localStorage.getItem('nexora_wishlist_items')) || [];
    } catch(e) {
      items = [];
    }

    if (counter) counter.textContent = items.length;

    // Immediately synchronize header badges
    document.querySelectorAll('[data-wishlist-count]').forEach((el) => {
      el.textContent = items.length;
      if (items.length > 0) {
        el.style.setProperty('display', 'flex', 'important');
        el.classList.remove('hidden');
      } else {
        el.style.setProperty('display', 'none', 'important');
        el.classList.add('hidden');
      }
    });

    if (items.length === 0) {
      grid.innerHTML = '';
      grid.style.display = 'none';
      emptyState.style.display = 'block';
      if (clearBtn) clearBtn.style.display = 'none';
      return;
    }

    grid.style.display = 'grid';
    emptyState.style.display = 'none';
    if (clearBtn) clearBtn.style.display = 'inline-block';

    let html = '';
    items.forEach((item) => {
      html += `
        <div class="group relative rounded-2xl bg-surface-container-lowest border border-outline-variant/40 hover:border-outline-variant p-4 flex flex-col justify-between transition-all duration-300">
          <div>
            <div class="relative aspect-square rounded-xl bg-surface-container-low overflow-hidden mb-3">
              <span class="absolute top-2.5 left-2.5 z-10 px-2 py-0.5 rounded-full bg-primary text-on-primary text-[10px] font-bold tracking-wider">SAVED</span>
              <button 
                type="button" 
                class="absolute top-2.5 right-2.5 z-10 w-8 h-8 rounded-full bg-surface-container-lowest text-rose-500 hover:bg-rose-50 flex items-center justify-center transition-colors shadow-sm"
                title="Remove from Wishlist"
                onclick="window.Nexora.removeFromWishlist('${item.id}');"
              >
                <span class="material-symbols-outlined text-[17px] fill-1">delete</span>
              </button>
              <a href="${item.url || '#'}" class="block w-full h-full">
                <img src="${item.image || 'https://via.placeholder.com/400'}" alt="${item.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy">
              </a>
            </div>
            <h3 class="text-headline-sm font-semibold text-on-surface group-hover:text-primary transition-colors line-clamp-1">
              <a href="${item.url || '#'}">${item.title}</a>
            </h3>
          </div>
          <div class="mt-4 pt-3 border-t border-outline-variant/20 flex items-center justify-between gap-3">
            <span class="text-headline-sm font-bold text-on-surface">${item.price || ''}</span>
            <button 
              type="button" 
              class="h-9 px-3.5 rounded-lg bg-primary hover:bg-primary-container text-on-primary text-label-md font-semibold transition-all flex items-center gap-1.5"
              onclick="moveWishlistToCart('${item.id}', '${item.title}');"
            >
              <span class="material-symbols-outlined text-[16px]">add_shopping_cart</span>
              <span>Move to Cart</span>
            </button>
          </div>
        </div>
      `;
    });

    grid.innerHTML = html;
  }

  function moveWishlistToCart(id, title) {
    // Add to cart
    if (typeof updateCartStateLocally === 'function') {
      updateCartStateLocally(1);
    }
    if (typeof showToast === 'function') {
      showToast(`Moved "${title}" to Cart!`, 'shopping_bag');
    }
  }
</script>

{% schema %}
{
  "name": "Wishlist Page",
  "settings": []
}
{% endschema %}
