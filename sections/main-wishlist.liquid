{%- comment -%}
  NEXORA / TEKNOVA - Main Wishlist Section
  Local storage-powered wishlist page with reactive cards and Move to Cart
{%- endcomment -%}

<section class="py-12 bg-surface">
  <div class="max-w-7xl mx-auto px-6">
    <div class="mb-8 pb-6 border-b border-outline-variant/30 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <nav class="flex items-center space-x-2 text-label-sm font-label-sm text-on-surface-variant mb-2">
          <a href="{{ routes.root_url }}" class="hover:text-primary">Home</a>
          <span>/</span>
          <span class="text-on-surface font-semibold">Wishlist</span>
        </nav>
        <h1 class="text-3xl sm:text-headline-lg font-headline-lg font-bold text-on-surface">
          Saved Hardware &amp; Wishlist
        </h1>
        <p class="text-body-md font-body-md text-on-surface-variant mt-1">
          Review saved configurations, monitor stock availability, and move gear directly into your active cart.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <span class="text-label-md font-label-md text-primary bg-primary/10 px-3.5 py-1.5 rounded-full font-bold">
          <span id="wishlist-page-counter">0</span> Saved Items
        </span>
        <button 
          type="button" 
          id="clear-wishlist-btn"
          class="text-label-md font-label-md text-on-surface-variant hover:text-rose-500 font-semibold transition-colors"
          style="display: none;"
        >
          Clear All
        </button>
      </div>
    </div>

    <!-- Active Wishlist Grid -->
    <div id="wishlist-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6"></div>

    <!-- Empty State -->
    <div id="wishlist-empty-state" class="text-center py-20 bg-surface-container-lowest rounded-3xl border border-outline-variant/30 p-8 max-w-xl mx-auto my-6 shadow-sm">
      <div class="w-16 h-16 rounded-full bg-surface-container-low text-primary flex items-center justify-center mx-auto mb-4">
        <span class="material-symbols-outlined text-[32px]">favorite</span>
      </div>
      <h2 class="text-headline-sm font-bold text-on-surface mb-2">Your Wishlist is Empty</h2>
      <p class="text-body-md text-on-surface-variant mb-6">
        Curate your personal tech arsenal by tapping the heart icon on any flagship smartphone, studio headphones, or workstation.
      </p>
      <a href="{{ routes.all_products_collection_url }}" class="inline-flex items-center gap-2 px-8 py-3 rounded-xl bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md font-bold transition-all shadow-md">
        <span>Explore 2026 Fleet</span>
        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
      </a>
    </div>

    <!-- Fallback / Recommended Section -->
    <div class="mt-20 pt-12 border-t border-outline-variant/30">
      <div class="flex items-end justify-between mb-8">
        <div>
          <span class="text-label-md font-label-md uppercase tracking-wider text-secondary font-semibold">Recommended Gear</span>
          <h3 class="text-headline-md font-headline-md font-bold text-on-surface mt-1">Popular Among Tech Enthusiasts</h3>
        </div>
        <a href="{{ routes.all_products_collection_url }}" class="text-label-md font-bold text-primary hover:underline">
          View All Hardware &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {%- if collections['all'].products.size > 0 -%}
          {%- for product in collections['all'].products limit: 4 -%}
