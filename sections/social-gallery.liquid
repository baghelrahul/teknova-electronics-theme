{%- comment -%}
  NEXORA / TEKNOVA - Section 15: Instagram & Community Social Gallery
  5-column aesthetic social showcase with hover likes and shop tags
{%- endcomment -%}

<section class="py-20 bg-surface">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
      <div>
        <span class="text-label-md font-label-md uppercase tracking-wider text-secondary font-semibold">
          {{ section.settings.eyebrow | default: 'Aesthetic Ecosystem' }}
        </span>
        <h2 class="text-headline-lg font-headline-lg text-on-surface mt-1">
          {{ section.settings.heading | default: 'Follow the Future of Tech' }}
        </h2>
      </div>

      {%- if section.settings.handle_text != blank -%}
        <a class="mt-4 md:mt-0 text-label-md font-label-md font-bold text-primary hover:underline flex items-center gap-1.5" href="{{ section.settings.handle_link | default: 'https://instagram.com' }}" target="_blank" rel="noopener">
          <span>{{ section.settings.handle_text }}</span>
          <span class="material-symbols-outlined text-[16px]">open_in_new</span>
        </a>
      {%- endif -%}
    </div>

    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="group relative aspect-square rounded-2xl overflow-hidden bg-surface-container-low" {{ block.shopify_attributes }}>
            <img 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" 
              src="{{ block.settings.image_url }}" 
              alt="{{ block.settings.likes_count | default: 'Community post' | escape }}"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-inverse-surface/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-4 text-center text-inverse-on-surface">
              <span class="material-symbols-outlined text-[28px] mb-1">photo_camera</span>
              <span class="text-label-sm font-label-sm font-bold">{{ block.settings.likes_count }}</span>
              <a href="{{ block.settings.link | default: '#' }}" class="mt-2 px-2.5 py-1 rounded bg-white/20 text-[10px] uppercase font-bold tracking-wider hover:bg-primary transition-colors">
                Shop Setup
              </a>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

