{%- comment -%}
  NEXORA / TEKNOVA - Main Product Section
  Clean, high-tech product detail layout matching the Nexora aesthetic
{%- endcomment -%}

<section class="py-12 bg-surface">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-label-sm font-label-sm text-on-surface-variant mb-8">
      <a href="{{ routes.root_url }}" class="hover:text-primary">Home</a>
      <span>/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}" class="hover:text-primary">{{ collection.title }}</a>
        <span>/</span>
      {%- endif -%}
      <span class="text-on-surface font-semibold truncate">{{ product.title }}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Media Gallery -->
      <div class="lg:col-span-7 space-y-4">
        <div class="aspect-square rounded-2xl bg-surface-container-lowest border border-outline-variant/40 overflow-hidden relative shadow-sm">
          {%- if product.featured_image != blank -%}
            <img 
              id="MainProductImage"
              src="{{ product.featured_image | image_url: width: 1200 }}" 
              alt="{{ product.title | escape }}"
              class="w-full h-full object-contain p-6"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="flex items-center gap-3 overflow-x-auto custom-scrollbar pb-2">
            {%- for image in product.images -%}
              <button 
                type="button" 
                class="w-20 h-20 rounded-xl bg-surface-container-lowest border border-outline-variant/40 overflow-hidden shrink-0 hover:border-primary transition-all p-1"
                onclick="document.getElementById('MainProductImage').src = '{{ image | image_url: width: 1200 }}';"
              >
                <img src="{{ image | image_url: width: 160 }}" alt="{{ product.title | escape }}" class="w-full h-full object-contain">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Product Form & Info -->
      <div class="lg:col-span-5 flex flex-col justify-start">
        {%- if product.vendor != blank -%}
          <span class="text-label-sm font-label-sm uppercase tracking-wider text-primary font-bold mb-2">
            {{ product.vendor }}
          </span>
        {%- endif -%}

        <h1 class="text-2xl sm:text-headline-md font-headline-md font-bold text-on-surface mb-3">
          {{ product.title }}
        </h1>

        <div class="flex items-center gap-3 mb-6">
          <div class="flex text-amber-500">
            {%- for i in (1..5) -%}
              <span class="material-symbols-outlined text-[18px] fill-1">star</span>
            {%- endfor -%}
          </div>
          <span class="text-body-sm font-body-sm font-bold text-on-surface">4.9</span>
          <span class="text-body-sm font-body-sm text-on-surface-variant">(Verified Owners)</span>
          <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 text-label-sm font-label-sm font-semibold">
            In Stock
          </span>
        </div>

        <!-- Price -->
        <div class="flex items-baseline gap-3 mb-6 pb-6 border-b border-outline-variant/30">
          <span class="text-3xl font-display font-bold text-on-surface">
            {{ product.price | money }}
          </span>
          {%- if product.compare_at_price > product.price -%}
            <span class="text-xl text-on-surface-variant/60 line-through">
              {{ product.compare_at_price | money }}
            </span>
            <span class="px-2 py-0.5 rounded-full bg-primary/10 text-primary font-label-sm text-label-sm font-bold">
              Save {{ product.compare_at_price | minus: product.price | money }}
            </span>
          {%- endif -%}
        </div>

        <!-- Form -->
        {% form 'product', product, id: 'product-form' %}
          {%- unless product.has_only_default_variant -%}
            <div class="space-y-4 mb-6">
              {%- for option in product.options_with_values -%}
                <div>
                  <label class="block text-label-md font-label-md font-semibold text-on-surface mb-2">
                    {{ option.name }}
                  </label>
                  <select name="id" class="w-full h-11 px-4 rounded-lg bg-surface-container-lowest border border-outline-variant/60 text-body-md font-body-md text-on-surface focus:outline-none focus:border-primary">
                    {%- for variant in product.variants -%}
                      <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                        {{ variant.title }} - {{ variant.price | money }} {% unless variant.available %}(Sold Out){% endunless %}
                      </option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endfor -%}
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {%- endunless -%}

          <div class="flex items-center gap-4 mb-6">
            <div class="w-28 h-12 flex items-center border border-outline-variant/60 rounded-lg bg-surface-container-lowest">
              <button type="button" class="w-9 h-full flex items-center justify-center text-on-surface-variant hover:text-on-surface" onclick="const input = this.nextElementSibling; if(input.value > 1) input.value--;">-</button>
              <input type="number" name="quantity" value="1" min="1" class="w-10 h-full text-center border-none bg-transparent font-semibold text-on-surface focus:ring-0">
              <button type="button" class="w-9 h-full flex items-center justify-center text-on-surface-variant hover:text-on-surface" onclick="const input = this.previousElementSibling; input.value++;">+</button>
            </div>

            <button 
              type="submit" 
              name="add"
              class="flex-1 h-12 px-6 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md font-bold transition-all shadow-md flex items-center justify-center gap-2"
              {% unless product.available %}disabled{% endunless %}
            >
              <span class="material-symbols-outlined text-[18px]">shopping_bag</span>
              <span>{% if product.available %}Add to Cart{% else %}Sold Out{% endif %}</span>
            </button>
          </div>
        {% endform %}

        <!-- Assurance Box -->
        <div class="p-4 rounded-xl bg-surface-container-low border border-outline-variant/40 space-y-3 mb-6">
          <div class="flex items-center gap-3 text-body-sm text-on-surface">
            <span class="material-symbols-outlined text-[20px] text-primary">local_shipping</span>
            <span>Free Express Insured Delivery on orders above ₹999</span>
          </div>
          <div class="flex items-center gap-3 text-body-sm text-on-surface">
            <span class="material-symbols-outlined text-[20px] text-secondary">verified_user</span>
            <span>1-Year Official Brand Manufacturer Warranty Assistance</span>
          </div>
          <div class="flex items-center gap-3 text-body-sm text-on-surface">
            <span class="material-symbols-outlined text-[20px] text-primary">sync</span>
            <span>Hassle-Free 7-Day Doorstep Replacement</span>
          </div>
        </div>

        <!-- Description -->
        {%- if product.description != blank -%}
          <div class="prose max-w-none text-body-md text-on-surface-variant pt-6 border-t border-outline-variant/30 leading-relaxed">
            {{ product.description }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Information",
  "settings": []
}
{% endschema %}
