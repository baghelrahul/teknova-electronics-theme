{%- comment -%}
  NEXORA / TEKNOVA - Main Page Section
  Editorial page layout for About, Terms, Privacy, etc.
{%- endcomment -%}

<section class="py-16 bg-surface">
  <div class="max-w-4xl mx-auto px-6">
    <h1 class="text-3xl sm:text-headline-lg font-headline-lg font-bold text-on-surface mb-8 pb-4 border-b border-outline-variant/30">
      {{ page.title }}
    </h1>

    <div class="prose max-w-none text-body-lg text-on-surface-variant leading-relaxed">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
