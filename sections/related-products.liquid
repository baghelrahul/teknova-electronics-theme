        %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Related Products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Aesthetic Synergy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Paired Architecture"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Hardware engineered to operate seamlessly together with zero latency."
    }
  ]
}
{% endschema %}
